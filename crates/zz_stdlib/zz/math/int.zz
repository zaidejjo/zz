// Pure-ZZ integer math helpers — aggregation & number theory.
// Module: std.math
// File: int.zz (part of std.math split, see crates/zz_stdlib/zz/math/)

// ── Int aggregation ──────────────────────────────────────────────────────────

func math.sum<T: Num>(arr: [T]) -> Option<T> {
    if vec.len(arr) == 0 {
        return .none
    }
    total := arr[0]
    i := 1
    n := vec.len(arr)
    while i < n {
        total = total + arr[i]
        i = i + 1
    }
    return .some(total)
}

func math.product<T: Num>(arr: [T]) -> Option<T> {
    if vec.len(arr) == 0 {
        return .none
    }
    total := arr[0]
    i := 1
    n := vec.len(arr)
    while i < n {
        total = total * arr[i]
        i = i + 1
    }
    return .some(total)
}

func math.count<T: Eq>(arr: [T], target: T) -> int {
    n := 0
    for x in arr {
        if x == target {
            n = n + 1
        }
    }
    return n
}

// ── Number theory ────────────────────────────────────────────────────────────

func math.gcd(a: int, b: int) -> int {
    mut_a := a
    if mut_a < 0 {
        mut_a = 0 - mut_a
    }
    mut_b := b
    if mut_b < 0 {
        mut_b = 0 - mut_b
    }
    while mut_b != 0 {
        tmp := mut_b
        mut_b = mut_a % mut_b
        mut_a = tmp
    }
    return mut_a
}

func math.lcm(a: int, b: int) -> int {
    if a == 0 || b == 0 {
        return 0
    }
    abs_a := a
    if abs_a < 0 {
        abs_a = 0 - abs_a
    }
    abs_b := b
    if abs_b < 0 {
        abs_b = 0 - abs_b
    }
    return (abs_a / math.gcd(abs_a, abs_b)) * abs_b
}

func math.factorial(n: int) -> Result<int, str> {
    if n < 0 {
        return .err("factorial: negative input")
    }
    if n > 20 {
        return .err("factorial: input too large (max 20)")
    }
    result := 1
    i := 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return .ok(result)
}

func math.isqrt(n: int) -> Result<int, str> {
    if n < 0 {
        return .err("isqrt: negative input")
    }
    if n == 0 {
        return .ok(0)
    }
    // Newton's method for integer square root
    mut_x := n
    mut_y := (n + 1) / 2
    while mut_y < mut_x {
        mut_x = mut_y
        mut_y = (mut_x + n / mut_x) / 2
    }
    return .ok(mut_x)
}
