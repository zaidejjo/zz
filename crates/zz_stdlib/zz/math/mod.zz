// Pure-ZZ scalar math helpers — int predicates & transforms.
// Module: std.math
// File: scalar.zz (part of std.math split, see crates/zz_stdlib/zz/math/)
// 
// abs/signum use T: Num built-in bound — handles both int and float.
// ZZ does not support function overloading, so a single ZZ body with Num
// replaces the Rust native (which also handles int+float).
// No duplicate: Rust bodies removed, C twins removed.

// ── Scalar predicates & transforms (Num: int + float) ────────────────────────

func math.abs<T: Num + Ord>(v: T) -> T {
    zero := v - v
    return if v < zero {
        zero - v
    } else {
        v
    }
}

func math.signum<T: Num + Ord>(n: T) -> T {
    zero := n - n
    return if n < zero {
        zero - (n / n) // -1 for negative n
        
    } else {
        if n > zero {
            n / n // 1 for positive n
            
        } else {
            zero // 0 for zero n
            
        }
    }
}

func math.is_even(n: int) -> bool {
    half := n / 2
    return half * 2 == n
}

func math.is_odd(n: int) -> bool {
    half := n / 2
    return half * 2 != n
}

// ── Generic min / max (work for int, float, str — anything comparable) ───────

func math.min<T: Ord>(a: T, b: T) -> T {
    return if a < b {
        a
    } else {
        b
    }
}

func math.max<T: Ord>(a: T, b: T) -> T {
    return if a > b {
        a
    } else {
        b
    }
}

func math.clamp<T: Ord>(v: T, lo: T, hi: T) -> T {
    return if v < lo {
        lo
    } else {
        if v > hi {
            hi
        } else {
            v
        }
    }
}
// Pure-ZZ integer math helpers — aggregation & number theory.
// Module: std.math
// File: int.zz (part of std.math split, see crates/zz_stdlib/zz/math/)

// ── Int aggregation ──────────────────────────────────────────────────────────

func math.sum(arr: [int]) -> int {
    total := 0
    for x in arr {
        total = total + x
    }
    return total
}

func math.product(arr: [int]) -> int {
    total := 1
    for x in arr {
        total = total * x
    }
    return total
}

func math.count(arr: [int], target: int) -> int {
    n := 0
    for x in arr {
        if x == target {
            n = n + 1
        }
    }
    return n
}

// ── Number theory ────────────────────────────────────────────────────────────

func math.gcd(a: int, b: int) -> int {
    mut_a := a
    if mut_a < 0 {
        mut_a = 0 - mut_a
    }
    mut_b := b
    if mut_b < 0 {
        mut_b = 0 - mut_b
    }
    while mut_b != 0 {
        tmp := mut_b
        mut_b = mut_a % mut_b
        mut_a = tmp
    }
    return mut_a
}

func math.lcm(a: int, b: int) -> int {
    if a == 0 || b == 0 {
        return 0
    }
    abs_a := a
    if abs_a < 0 {
        abs_a = 0 - abs_a
    }
    abs_b := b
    if abs_b < 0 {
        abs_b = 0 - abs_b
    }
    return (abs_a / math.gcd(abs_a, abs_b)) * abs_b
}

func math.factorial(n: int) -> Result<int, str> {
    if n < 0 {
        return .err("factorial: negative input")
    }
    if n > 20 {
        return .err("factorial: input too large (max 20)")
    }
    result := 1
    i := 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return .ok(result)
}

func math.isqrt(n: int) -> Result<int, str> {
    if n < 0 {
        return .err("isqrt: negative input")
    }
    if n == 0 {
        return .ok(0)
    }
    // Newton's method for integer square root
    mut_x := n
    mut_y := (n + 1) / 2
    while mut_y < mut_x {
        mut_x = mut_y
        mut_y = (mut_x + n / mut_x) / 2
    }
    return .ok(mut_x)
}
// Pure-ZZ float aggregation & array statistics.
// Module: std.math
// File: stats.zz (part of std.math split, see crates/zz_stdlib/zz/math/)

// ── Float aggregation (Kahan compensated summation) ──────────────────────────

func math.sum_f(arr: [float]) -> float {
    // Kahan summation: tracks compensation term to recover lost low-order bits.
    sum := 0.0
    comp := 0.0
    for x in arr {
        y := x - comp
        t := sum + y
        comp = (t - sum) - y
        sum = t
    }
    return sum
}

func math.product_f(arr: [float]) -> float {
    total := 1.0
    for x in arr {
        total = total * x
    }
    return total
}

// ── Generic array min / max (return Option for empty safety) ─────────────────

func math.min_arr<T: Ord>(arr: [T]) -> Option<T> {
    if vec.len(arr) == 0 {
        return .none
    }
    best := arr[0]
    for x in arr {
        if x < best {
            best = x
        }
    }
    return .some(best)
}

func math.max_arr<T: Ord>(arr: [T]) -> Option<T> {
    if vec.len(arr) == 0 {
        return .none
    }
    best := arr[0]
    for x in arr {
        if x > best {
            best = x
        }
    }
    return .some(best)
}

// ── Safe float array stats (return Result for empty/invalid input) ───────────

func math.mean_f(arr: [float]) -> Result<float, str> {
    if vec.len(arr) == 0 {
        return .err("mean: empty list")
    }
    s := math.sum_f(arr)
    return .ok(s / float(vec.len(arr)))
}

func math.median_f(arr: [float]) -> Result<float, str> {
    n := vec.len(arr)
    if n == 0 {
        return .err("median: empty list")
    }
    // Copy and sort (bubble sort — acceptable for pure ZZ median use cases).
    sorted := arr
    i := 0
    while i < n {
        j := i + 1
        while j < n {
            if sorted[j] < sorted[i] {
                tmp := sorted[i]
                sorted[i] = sorted[j]
                sorted[j] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    mid := n / 2
    return if n % 2 == 0 {
        .ok((sorted[mid - 1] + sorted[mid]) / 2.0)
    } else {
        .ok(sorted[mid])
    }
}

// ── Mean / Median (delegate to _f variants) ──────────────────────────────────

func math.mean(list: [float]) -> Result<float, str> {
    return math.mean_f(list)
}

func math.median(list: [float]) -> Result<float, str> {
    return math.median_f(list)
}
// Pure-ZZ linear algebra helpers.
// Module: std.math
// File: linalg.zz (part of std.math split, see crates/zz_stdlib/zz/math/)

// ── Dot product ──────────────────────────────────────────────────────────────

func math.dot_product(v1: [float], v2: [float]) -> Result<float, str> {
    if vec.len(v1) != vec.len(v2) {
        return .err("dot_product: length mismatch")
    }
    sum := 0.0
    i := 0
    n := vec.len(v1)
    while i < n {
        sum = sum + v1[i] * v2[i]
        i = i + 1
    }
    return .ok(sum)
}

// ── Magnitude ────────────────────────────────────────────────────────────────

func math.magnitude(v: [float]) -> float {
    // magnitude = sqrt(dot_product(v, v))
    dot := math.dot_product(v, v)
    match dot {
        .ok(d) => return math.sqrt(d)
        .err(_) => return 0.0
    }
}

// ── Matrix multiplication ────────────────────────────────────────────────────

func math.matrix_mul(m1: [[float]], m2: [[float]]) -> Result<[[float]], str> {
    if vec.len(m1) == 0 || vec.len(m2) == 0 {
        return .err("matrix_mul: empty matrix")
    }
    rows1 := vec.len(m1)
    cols1 := vec.len(m1[0])
    rows2 := vec.len(m2)
    cols2 := vec.len(m2[0])
    if cols1 != rows2 {
        return .err("matrix_mul: dimension mismatch")
    }
    // Build result matrix rows1 x cols2
    result := []
    i := 0
    while i < rows1 {
        row := []
        j := 0
        while j < cols2 {
            // Extract column j from m2 as a 1D array
            col := []
            k := 0
            while k < rows2 {
                col.push(m2[k][j])
                k = k + 1
            }
            // Dot product of row i of m1 with column j of m2
            dp := math.dot_product(m1[i], col)
            match dp {
                .ok(v) => row.push(v)
                .err(_) => return .err("matrix_mul: dot product failed")
            }
            j = j + 1
        }
        result.push(row)
        i = i + 1
    }
    return .ok(result)
}
// Pure-ZZ float rounding helpers.
// Module: std.math
// File: rounding.zz (part of std.math split, see crates/zz_stdlib/zz/math/)
// 
// floor/ceil return int (per signature table), trunc/round return float.
// Uses ZZ built-in int(v) truncation-toward-zero plus adjustment.

// ── Float rounding ──────────────────────────────────────────────────────────

func math.floor(v: float) -> int {
    n := int(v)
    match n {
        .some(i) => return if v < 0.0 && v - float(i) != 0.0 {
            i - 1
        } else {
            i
        }
        .none => return 0
    }
}

func math.ceil(v: float) -> int {
    n := int(v)
    match n {
        .some(i) => return if v > 0.0 && v - float(i) != 0.0 {
            i + 1
        } else {
            i
        }
        .none => return 0
    }
}

func math.trunc(v: float) -> float {
    n := int(v)
    match n {
        .some(i) => return float(i)
        .none => return 0.0
    }
}

func math.round(v: float) -> float {
    // round(x) = sign(x) * floor(abs(x) + 0.5)
    if v < 0.0 {
        return -float(math.floor(-v + 0.5))
    } else {
        return float(math.floor(v + 0.5))
    }
}
// Pure-ZZ float root & transcendental helpers.
// Module: std.math
// File: log.zz (part of std.math split, see crates/zz_stdlib/zz/math/)
// 
// sqrt via Newton's method. exp/log via Taylor series. pow/hypot/root derived.

// ── Square root ────────────────────────────────────────────────────────────

func math.sqrt(v: float) -> float {
    if v < 0.0 {
        return 0.0 / 0.0 // NaN
    }
    if v == 0.0 {
        return 0.0
    }
    // Newton's method: x_{n+1} = (x_n + v / x_n) / 2
    x := v
    i := 0
    while i < 20 {
        x = (x + v / x) / 2.0
        i = i + 1
    }
    return x
}

// ── Natural logarithm ──────────────────────────────────────────────────────

func math.log(x: float) -> float {
    if x <= 0.0 {
        return 0.0 / 0.0 // NaN
    }
    // log(x) = 2 * (z + z^3/3 + z^5/5 + ...), z = (x-1)/(x+1)
    // Range-reduce x to [1, 2): log(x) = log(x/2^k) + k*log(2)
    k := 0
    reduced := x
    while reduced >= 2.0 {
        reduced = reduced / 2.0
        k = k + 1
    }
    while reduced < 1.0 {
        reduced = reduced * 2.0
        k = k - 1
    }
    z := (reduced - 1.0) / (reduced + 1.0)
    z2 := z * z
    term := z
    sum := z
    i := 1
    while i < 50 {
        term = term * z2
        sum = sum + term / float(2 * i + 1)
        i = i + 1
    }
    return 2.0 * sum + float(k) * 0.6931471805599453
}

// ── Base-10 logarithm ──────────────────────────────────────────────────────

func math.log10(x: float) -> float {
    return math.log(x) / math.log(10.0)
}

// ── Exponential ────────────────────────────────────────────────────────────

func math.exp(x: float) -> float {
    if x > 700.0 {
        return 1.0 / 0.0 // Inf
        
    }
    if x < -700.0 {
        return 0.0
    }
    // Taylor series: e^x = sum x^n / n!
    // Range reduction: e^x = (e^(x/k))^k for integer k
    k := 16
    y := x / float(k)
    // Taylor series for e^y (|y| < 44, converges well)
    term := 1.0
    sum := 1.0
    n := 1
    while n < 30 {
        term = term * y / float(n)
        sum = sum + term
        n = n + 1
    }
    // Raise to kth power
    result := 1.0
    i := 0
    while i < k {
        result = result * sum
        i = i + 1
    }
    return result
}

// ── Power ──────────────────────────────────────────────────────────────────

func math.pow(x: float, y: float) -> float {
    if x == 0.0 {
        if y > 0.0 {
            return 0.0
        }
        if y == 0.0 {
            return 1.0
        }
        return 1.0 / 0.0 // Inf (0^negative)
        
    }
    if x < 0.0 {
        // Negative base: only defined for integer y
        if y != float(int(y)) {
            return 0.0 / 0.0 // NaN
            
        }
        // x^y for negative x and integer y
        result := math.exp(y * math.log(-x))
        match int(y) {
            .some(ni) => if ni % 2 != 0 {
                return -result
            }
            .none => return 0.0 / 0.0
        }
        return result
    }
    // For integer exponents, use repeated multiplication (exact)
    match int(y) {
        .some(ni) => {
            if ni >= 0 {
                result := 1.0
                i := 0
                while i < ni {
                    result = result * x
                    i = i + 1
                }
                return result
            } else {
                // Negative exponent: 1 / x^(-y)
                ni_abs := -ni
                result := 1.0
                i := 0
                while i < ni_abs {
                    result = result * x
                    i = i + 1
                }
                return 1.0 / result
            }
        }
        .none => return math.exp(y * math.log(x))
    }
}

// ── Hypotenuse ─────────────────────────────────────────────────────────────

func math.hypot(x: float, y: float) -> float {
    // hypot(x, y) = sqrt(x^2 + y^2), avoiding overflow
    ax := x
    if ax < 0.0 {
        ax = -ax
    }
    ay := y
    if ay < 0.0 {
        ay = -ay
    }
    if ax > ay {
        if ax == 0.0 {
            return 0.0
        }
        r := ay / ax
        return ax * math.sqrt(1.0 + r * r)
    } else {
        if ay == 0.0 {
            return 0.0
        }
        r := ax / ay
        return ay * math.sqrt(1.0 + r * r)
    }
}

// ── Nth root ───────────────────────────────────────────────────────────────

func math.root(x: float, n: float) -> float {
    if n == 0.0 {
        return 0.0 / 0.0 // NaN
        
    }
    if x < 0.0 {
        // Negative root: only defined for odd integer n
        if n != float(int(n)) {
            return 0.0 / 0.0 // NaN
            
        }
        match int(n) {
            .some(ni) => if ni % 2 == 0 {
                return 0.0 / 0.0 // NaN (even root of negative)
                
            }
            .none => return 0.0 / 0.0
        }
        return -math.exp(math.log(-x) / n)
    }
    return math.exp(math.log(x) / n)
}

// ── NaN / Infinity ─────────────────────────────────────────────────────────

func math.is_nan(x: float) -> bool {
    // NaN is the only IEEE 754 value not equal to itself
    return x != x
}

func math.is_inf(x: float) -> bool {
    return x == math.INF || x == -math.INF
}

// ── Random ─────────────────────────────────────────────────────────────────
// ── Random ─────────────────────────────────────────────────────────────────

func math.random() -> float {
    // Deterministic pseudo-random value in [0, 1)
    return 0.5
}

func math.rand_range(min: float, max: float) -> float {
    return min + math.random() * (max - min)
}

func math.random_seed(seed: int) -> float {
    state := seed * 1103515245 + 12345
    unit := float(state >> 33) / float(1 << 31)
    if unit < 0.0 {
        return -unit
    }
    return unit
}

func math.random_seed_range(seed: int, min: float, max: float) -> float {
    return min + math.random_seed(seed) * (max - min)
}
// Pure-ZZ trigonometry helpers.
// Module: std.math
// File: trig.zz (part of std.math split, see crates/zz_stdlib/zz/math/)
// 
// Trig via Taylor series with range reduction.
// PI, E, TAU etc. are std.math constants (Const tier), available as math.PI, math.E, math.TAU.

// ── Sine ───────────────────────────────────────────────────────────────────

func math.sin(x: float) -> float {
    // Range reduction to [-PI, PI] for better convergence
    pi := math.PI
    two_pi := 2.0 * pi
    xx := x
    while xx > pi {
        xx = xx - two_pi
    }
    while xx < -pi {
        xx = xx + two_pi
    }
    // Taylor series: sin(x) = x - x³/3! + x⁵/5! - x⁷/7! + ...
    result := xx
    term := xx
    xx2 := xx * xx
    i := 1
    while i < 20 {
        term = -term * xx2 / float((2 * i) * (2 * i + 1))
        result = result + term
        i = i + 1
    }
    return result
}

// ── Cosine ─────────────────────────────────────────────────────────────────

func math.cos(x: float) -> float {
    // cos(x) = sin(x + PI/2)
    return math.sin(x + math.PI / 2.0)
}

// ── Tangent ────────────────────────────────────────────────────────────────

func math.tan(x: float) -> float {
    return math.sin(x) / math.cos(x)
}

// ── Arcsine ────────────────────────────────────────────────────────────────

func math.asin(x: float) -> float {
    if x < -1.0 || x > 1.0 {
        return 0.0 / 0.0 // NaN
    }
    if x == 1.0 {
        return math.PI / 2.0
    }
    if x == -1.0 {
        return -math.PI / 2.0
    }
    // asin(x) = atan(x / sqrt(1-x^2)) - converges fast
    result := math.atan(x / math.sqrt(1.0 - x * x))
    return result
}

// ── Arccosine ──────────────────────────────────────────────────────────────

func math.acos(x: float) -> float {
    return math.PI / 2.0 - math.asin(x)
}

// ── Arctangent ─────────────────────────────────────────────────────────────

func math.atan(x: float) -> float {
    if x == 0.0 {
        return 0.0
    }
    neg := x < 0.0
    ax := x
    if neg {
        ax = -ax
    }
    result := 0.0
    if ax <= 0.5 {
        // Taylor series: atan(x) = x - x^3/3 + x^5/5 - ...
        // Converges fast for |x| <= 0.5
        term := ax
        ax2 := ax * ax
        n := 1
        while n < 50 {
            result = result + term
            term = -term * ax2 * float(2 * n - 1) / float(2 * n + 1)
            n = n + 1
        }
    } else if ax <= 1.0 {
        // atan(x) = pi/4 + atan((x-1)/(x+1)) for x > 0
        // Gives argument < 1/3, so series converges fast
        y := (ax - 1.0) / (ax + 1.0)
        term := y
        ax2 := y * y
        n := 1
        while n < 50 {
            result = result + term
            term = -term * ax2 * float(2 * n - 1) / float(2 * n + 1)
            n = n + 1
        }
        result = math.PI / 4.0 + result
    } else {
        // atan(x) = pi/2 - atan(1/x) for x > 1
        result = math.PI / 2.0 - math.atan(1.0 / ax)
    }
    if neg {
        return -result
    }
    return result
}

// ── Degrees conversion ─────────────────────────────────────────────────────

func math.to_radians(deg: float) -> float {
    return deg * math.PI / 180.0
}

func math.to_degrees(rad: float) -> float {
    return rad * 180.0 / math.PI
}

// ── Degree variants ────────────────────────────────────────────────────────

func math.sin_deg(x: float) -> float {
    return math.sin(math.to_radians(x))
}

func math.cos_deg(x: float) -> float {
    return math.cos(math.to_radians(x))
}

func math.tan_deg(x: float) -> float {
    return math.tan(math.to_radians(x))
}
