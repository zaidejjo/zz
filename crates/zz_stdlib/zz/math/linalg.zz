// Pure-ZZ linear algebra helpers.
// Module: std.math
// File: linalg.zz (part of std.math split, see crates/zz_stdlib/zz/math/)

// ── Dot product ──────────────────────────────────────────────────────────────

func math.dot_product(v1: [float], v2: [float]) -> Result<float, str> {
    if vec.len(v1) != vec.len(v2) {
        return .err("dot_product: length mismatch")
    }
    sum := 0.0
    i := 0
    n := vec.len(v1)
    while i < n {
        sum = sum + v1[i] * v2[i]
        i = i + 1
    }
    return .ok(sum)
}

// ── Magnitude ────────────────────────────────────────────────────────────────

func math.magnitude(v: [float]) -> float {
    // magnitude = sqrt(dot_product(v, v))
    dot := math.dot_product(v, v)
    match dot {
        .ok(d) => return math.sqrt(d)
        .err(_) => return 0.0
    }
}

// ── Matrix multiplication ────────────────────────────────────────────────────

func math.matrix_mul(m1: [[float]], m2: [[float]]) -> Result<[[float]], str> {
    if vec.len(m1) == 0 || vec.len(m2) == 0 {
        return .err("matrix_mul: empty matrix")
    }
    rows1 := vec.len(m1)
    cols1 := vec.len(m1[0])
    rows2 := vec.len(m2)
    cols2 := vec.len(m2[0])
    if cols1 != rows2 {
        return .err("matrix_mul: dimension mismatch")
    }
    // Build result matrix rows1 x cols2
    result := []
    i := 0
    while i < rows1 {
        row := []
        j := 0
        while j < cols2 {
            // Extract column j from m2 as a 1D array
            col := []
            k := 0
            while k < rows2 {
                col.push(m2[k][j])
                k = k + 1
            }
            // Dot product of row i of m1 with column j of m2
            dp := math.dot_product(m1[i], col)
            match dp {
                .ok(v) => row.push(v)
                .err(_) => return .err("matrix_mul: dot product failed")
            }
            j = j + 1
        }
        result.push(row)
        i = i + 1
    }
    return .ok(result)
}
