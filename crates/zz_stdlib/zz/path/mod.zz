// Pure-ZZ path helpers — compiled once, shared by VM and AOT.
// Module: std.path
//
// Lexical path manipulation over strings. No I/O and no filesystem access:
// `std.fs` keeps the actual I/O operations while its `join` shares this
// lexical algorithm. Separator style follows `std.env.os()` (`"windows"`
// → `\`, everything else → `/`); both separators are accepted as input on
// either style, matching the native `std.fs` path functions.

// ── Separator queries ────────────────────────────────────────────────────────

func path.is_absolute(p: str) -> bool {
    if str.starts_with(p, "/") {
        return true
    }
    if str.starts_with(p, "\\") {
        return true
    }
    // Drive-absolute (`C:/`, `C:\`) only counts on Windows; elsewhere a
    // drive prefix is just another path segment. Bare `C:x` is
    // drive-relative, never absolute.
    if std.env.os() == "windows" {
        if str.length(p) > 2 {
            if p[1] == ":" {
                if p[2] == "/" {
                    return true
                }
                if p[2] == "\\" {
                    return true
                }
            }
        }
    }
    false
}

// ── Normalization & joining ──────────────────────────────────────────────────

func path.normalize(p: str) -> str {
    if p == "" {
        return "."
    }
    windows := std.env.os() == "windows"
    // Unify separators so a single pass handles both inputs.
    cleaned := str.replace(p, "\\", "/")
    absolute := false
    unc := false
    drive := ""
    if windows {
        if str.starts_with(cleaned, "//") {
            // UNC (`//server/share/...`): the `//server/share` head is a
            // root and is never popped by `..`.
            unc = true
            absolute = true
        } else {
            if str.starts_with(cleaned, "/") {
                absolute = true
            }
        }
    } else {
        if str.starts_with(cleaned, "/") {
            absolute = true
        }
    }
    parts := str.split(cleaned, "/")
    start := 0
    if windows {
        if unc == false {
            if vec.len(parts) > 0 {
                first := parts[0]
                if str.length(first) == 2 {
                    if first[1] == ":" {
                        // Drive prefix (`C:`): never popped by `..`.
                        drive = first
                        start = 1
                        if str.starts_with(cleaned, first + "/") {
                            absolute = true
                        }
                    }
                }
            }
        }
    }
    stack: [str] = []
    i := start
    n := vec.len(parts)
    while i < n {
        seg := parts[i]
        if seg == "" {
            i = i + 1
        } else {
            if seg == "." {
                i = i + 1
            } else {
                if seg == ".." {
                    m := vec.len(stack)
                    if m > 0 {
                        top := stack[m - 1]
                        if top == ".." {
                            stack = vec.push(stack, seg)
                        } else {
                            stack = vec.pop(stack)
                        }
                    } else {
                        if absolute {
                            // Clamped at the root: drop.
                        } else {
                            stack = vec.push(stack, seg)
                        }
                    }
                    i = i + 1
                } else {
                    stack = vec.push(stack, seg)
                    i = i + 1
                }
            }
        }
    }
    result := ""
    if drive != "" {
        result = drive
    }
    if unc {
        result = "//"
    } else {
        if absolute {
            result = result + "/"
        }
    }
    for s in stack {
        if result == "" {
            result = s
        } else {
            if str.ends_with(result, "/") {
                result = result + s
            } else {
                result = result + "/" + s
            }
        }
    }
    if result == "" {
        result = "."
    }
    if windows {
        result = str.replace(result, "/", "\\")
    }
    result
}

func path.join(a: str, b: str) -> str {
    if b == "" {
        return path.normalize(a)
    }
    if path.is_absolute(b) {
        return path.normalize(b)
    }
    if a == "" {
        return path.normalize(b)
    }
    path.normalize(a + "/" + b)
}

func path.join_all(parts: [str]) -> str {
    result := ""
    first := true
    for p in parts {
        if first {
            result = p
            first = false
        } else {
            result = path.join(result, p)
        }
    }
    path.normalize(result)
}

// ── Decomposition ────────────────────────────────────────────────────────────

func path.basename(p: str) -> str {
    n := path.normalize(p)
    if n == "." {
        return "."
    }
    if n == "/" {
        return "/"
    }
    windows := std.env.os() == "windows"
    sep := "/"
    if windows {
        sep = "\\"
        // Roots have no basename.
        if str.length(n) == 3 {
            if n[1] == ":" {
                return n
            }
        }
        if str.length(n) == 2 {
            if n[1] == ":" {
                return n
            }
        }
    }
    parts := str.split(n, sep)
    parts[vec.len(parts) - 1]
}

func path.dirname(p: str) -> str {
    n := path.normalize(p)
    if n == "/" {
        return "/"
    }
    windows := std.env.os() == "windows"
    sep := "/"
    if windows {
        sep = "\\"
        // Roots have no parent.
        if str.length(n) == 3 {
            if n[1] == ":" {
                return n
            }
        }
        if str.length(n) == 2 {
            if n[1] == ":" {
                return "."
            }
        }
    }
    parts := str.split(n, sep)
    if vec.len(parts) <= 1 {
        return "."
    }
    prefix := ""
    i := 0
    if windows {
        first := parts[0]
        if str.length(first) == 2 {
            if first[1] == ":" {
                prefix = first
                i = 1
            }
        }
    } else {
        if parts[0] == "" {
            prefix = "/"
            i = 1
        }
    }
    result := prefix
    last := vec.len(parts) - 1
    while i < last {
        if result == "" {
            result = parts[i]
        } else {
            if str.ends_with(result, sep) {
                result = result + parts[i]
            } else {
                result = result + sep + parts[i]
            }
        }
        i = i + 1
    }
    if result == "" {
        return "."
    }
    result
}

func path.extension(p: str) -> str {
    base := path.basename(p)
    if base == "." {
        return ""
    }
    if base == ".." {
        return ""
    }
    parts := str.split(base, ".")
    if vec.len(parts) <= 1 {
        return ""
    }
    // A leading dot is not an extension separator (`.gitignore` → `""`).
    if parts[0] == "" {
        if vec.len(parts) == 2 {
            return ""
        }
    }
    parts[vec.len(parts) - 1]
}
