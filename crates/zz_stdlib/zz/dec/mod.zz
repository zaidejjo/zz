// Pure-ZZ decimal helpers — exact money math on strings.
// Module: std.dec
//
// Decimals are `str` of form `[-]digits[.digits]`. No float drift:
// `dec.add("0.1","0.2") == "0.3"`. Scale capped at 18 places;
// extra digits truncate (bankers round later, not now).

func dec.is_valid(s: str) -> bool {
    t := str.trim(s)
    if t == "" {
        return false
    }
    i := 0
    if t[0] == "-" {
        i = 1
    }
    if i >= str.length(t) {
        return false
    }
    dots := 0
    digits := 0
    while i < str.length(t) {
        c := t[i]
        if c == "." {
            dots = dots + 1
            if dots > 1 {
                return false
            }
        } else {
            if c == "0" {
                digits = digits + 1
            } else {
                if c == "1" {
                    digits = digits + 1
                } else {
                    if c == "2" {
                        digits = digits + 1
                    } else {
                        if c == "3" {
                            digits = digits + 1
                        } else {
                            if c == "4" {
                                digits = digits + 1
                            } else {
                                if c == "5" {
                                    digits = digits + 1
                                } else {
                                    if c == "6" {
                                        digits = digits + 1
                                    } else {
                                        if c == "7" {
                                            digits = digits + 1
                                        } else {
                                            if c == "8" {
                                                digits = digits + 1
                                            } else {
                                                if c == "9" {
                                                    digits = digits + 1
                                                } else {
                                                    return false
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    digits > 0
}

func dec.scale_of(s: str) -> int {
    parts := str.split(s, ".")
    if vec.len(parts) <= 1 {
        return 0
    }
    str.length(parts[1])
}

func dec.pow10(n: int) -> int {
    p := 1
    i := 0
    while i < n {
        p = p * 10
        i = i + 1
    }
    p
}

func dec.to_scaled(s: str, scale: int) -> int {
    neg := false
    t := str.trim(s)
    if str.starts_with(t, "-") {
        neg = true
        t = t[1:]
    }
    parts := str.split(t, ".")
    whole := 0
    frac := ""
    if vec.len(parts) == 1 {
        whole = int(parts[0]) ?? 0
    } else {
        whole = int(parts[0]) ?? 0
        frac = parts[1]
    }
    while str.length(frac) < scale {
        frac = frac + "0"
    }
    if str.length(frac) > scale {
        frac = frac[:scale]
    }
    f := 0
    if frac == "" {
        f = 0
    } else {
        f = int(frac) ?? 0
    }
    v := whole * dec.pow10(scale) + f
    if neg {
        v = 0 - v
    }
    v
}

func dec.from_scaled(v: int, scale: int) -> str {
    neg := ""
    u := v
    if v < 0 {
        neg = "-"
        u = 0 - v
    }
    base := dec.pow10(scale)
    whole := u / base
    frac := u % base
    if scale == 0 {
        return neg + str(whole)
    }
    fs := str(whole) + "."
    need := scale
    fstr := str(frac)
    while str.length(fstr) < need {
        fstr = "0" + fstr
    }
    out := neg + str(whole) + "." + fstr
    dec.trim_zeros(out)
}

func dec.trim_zeros(s: str) -> str {
    if str.contains(s, ".") == false {
        return s
    }
    t := s
    while str.ends_with(t, "0") {
        t = t[:str.length(t) - 1]
    }
    if str.ends_with(t, ".") {
        t = t[:str.length(t) - 1]
    }
    if t == "-0" {
        return "0"
    }
    if t == "-0.0" {
        return "0"
    }
    t
}

func dec.add(a: str, b: str) -> str {
    sa := dec.scale_of(a)
    sb := dec.scale_of(b)
    sc := sa
    if sb > sc {
        sc = sb
    }
    if sc > 18 {
        sc = 18
    }
    va := dec.to_scaled(a, sc)
    vb := dec.to_scaled(b, sc)
    dec.from_scaled(va + vb, sc)
}

func dec.sub(a: str, b: str) -> str {
    sa := dec.scale_of(a)
    sb := dec.scale_of(b)
    sc := sa
    if sb > sc {
        sc = sb
    }
    if sc > 18 {
        sc = 18
    }
    va := dec.to_scaled(a, sc)
    vb := dec.to_scaled(b, sc)
    dec.from_scaled(va - vb, sc)
}

func dec.mul(a: str, b: str) -> str {
    sa := dec.scale_of(a)
    sb := dec.scale_of(b)
    sc := sa + sb
    if sc > 18 {
        sc = 18
    }
    va := dec.to_scaled(a, sa)
    vb := dec.to_scaled(b, sb)
    prod := va * vb
    if sa + sb > sc {
        prod = prod / dec.pow10(sa + sb - sc)
    }
    dec.from_scaled(prod, sc)
}

func dec.cmp(a: str, b: str) -> int {
    sa := dec.scale_of(a)
    sb := dec.scale_of(b)
    sc := sa
    if sb > sc {
        sc = sb
    }
    va := dec.to_scaled(a, sc)
    vb := dec.to_scaled(b, sc)
    if va < vb {
        return 0 - 1
    }
    if va > vb {
        return 1
    }
    0
}

func dec.eq(a: str, b: str) -> bool {
    dec.cmp(a, b) == 0
}

func dec.lt(a: str, b: str) -> bool {
    dec.cmp(a, b) < 0
}

func dec.gt(a: str, b: str) -> bool {
    dec.cmp(a, b) > 0
}

func dec.format(s: str, places: int) -> str {
    v := dec.to_scaled(s, places)
    dec.from_scaled(v, places)
}
