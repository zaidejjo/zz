// Pure-ZZ ANSI color & styling helpers — compiled once, shared by VM and AOT.
// Module: std.colors
//
// Zero-dependency terminal styling: every function takes a string and returns
// it wrapped in ANSI escape codes with a trailing reset (`\e[0m`) so colors
// never bleed into subsequent output. All functions are first-arg `str`, so
// they compose with pipelines:
//
//   "TEST FAIL" |> colors.red() |> colors.bold()
//   println(colors.green("ok") + " done in {ms}ms")
//
// Design notes:
//   - `\e` / `\xHH` escapes come from the lexer — no native helper needed.
//   - `rgb` clamps each channel to 0-255 (never errors, pipeline-friendly).
//   - `hex` falls back to the input unchanged on malformed codes (never errors).
//   - Nesting stacks codes (`bold(red(x))`); one trailing reset closes all.

// ── Standard palette (foreground 30-37) ──────────────────────────────────────

func colors.black(s: str) -> str {
    "\e[30m" + s + "\e[0m"
}

func colors.red(s: str) -> str {
    "\e[31m" + s + "\e[0m"
}

func colors.green(s: str) -> str {
    "\e[32m" + s + "\e[0m"
}

func colors.yellow(s: str) -> str {
    "\e[33m" + s + "\e[0m"
}

func colors.blue(s: str) -> str {
    "\e[34m" + s + "\e[0m"
}

func colors.magenta(s: str) -> str {
    "\e[35m" + s + "\e[0m"
}

func colors.cyan(s: str) -> str {
    "\e[36m" + s + "\e[0m"
}

func colors.white(s: str) -> str {
    "\e[37m" + s + "\e[0m"
}

// ── Bright palette (foreground 90-97) ────────────────────────────────────────

func colors.bright_black(s: str) -> str {
    "\e[90m" + s + "\e[0m"
}

func colors.bright_red(s: str) -> str {
    "\e[91m" + s + "\e[0m"
}

func colors.bright_green(s: str) -> str {
    "\e[92m" + s + "\e[0m"
}

func colors.bright_yellow(s: str) -> str {
    "\e[93m" + s + "\e[0m"
}

func colors.bright_blue(s: str) -> str {
    "\e[94m" + s + "\e[0m"
}

func colors.bright_magenta(s: str) -> str {
    "\e[95m" + s + "\e[0m"
}

func colors.bright_cyan(s: str) -> str {
    "\e[96m" + s + "\e[0m"
}

func colors.bright_white(s: str) -> str {
    "\e[97m" + s + "\e[0m"
}

// ── Background colors (40-47) ────────────────────────────────────────────────

func colors.bg_black(s: str) -> str {
    "\e[40m" + s + "\e[0m"
}

func colors.bg_red(s: str) -> str {
    "\e[41m" + s + "\e[0m"
}

func colors.bg_green(s: str) -> str {
    "\e[42m" + s + "\e[0m"
}

func colors.bg_yellow(s: str) -> str {
    "\e[43m" + s + "\e[0m"
}

func colors.bg_blue(s: str) -> str {
    "\e[44m" + s + "\e[0m"
}

func colors.bg_magenta(s: str) -> str {
    "\e[45m" + s + "\e[0m"
}

func colors.bg_cyan(s: str) -> str {
    "\e[46m" + s + "\e[0m"
}

func colors.bg_white(s: str) -> str {
