}

// ── Text styles ──────────────────────────────────────────────────────────────

func colors.bold(s: str) -> str {
    "\e[1m" + s + "\e[0m"
}

func colors.dim(s: str) -> str {
    "\e[2m" + s + "\e[0m"
}

func colors.italic(s: str) -> str {
    "\e[3m" + s + "\e[0m"
}

func colors.underline(s: str) -> str {
    "\e[4m" + s + "\e[0m"
}

func colors.reset(s: str) -> str {
    s + "\e[0m"
}

// ── Truecolor ────────────────────────────────────────────────────────────────

func colors.clamp255(v: int) -> int {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    v
}

func colors.rgb(s: str, r: int, g: int, b: int) -> str {
    rr := colors.clamp255(r)
    gg := colors.clamp255(g)
    bb := colors.clamp255(b)
    "\e[38;2;{rr};{gg};{bb}m" + s + "\e[0m"
}

func colors.bg_rgb(s: str, r: int, g: int, b: int) -> str {
    rr := colors.clamp255(r)
    gg := colors.clamp255(g)
    bb := colors.clamp255(b)
    "\e[48;2;{rr};{gg};{bb}m" + s + "\e[0m"
}

// Single hex digit → nibble, or -1 when not a hex digit.
func colors.hex_val(c: str) -> int {
    if c == "0" {
        return 0
    }
    if c == "1" {
        return 1
    }
    if c == "2" {
        return 2
    }
    if c == "3" {
        return 3
    }
    if c == "4" {
        return 4
    }
    if c == "5" {
        return 5
    }
    if c == "6" {
        return 6
    }
    if c == "7" {
        return 7
    }
    if c == "8" {
        return 8
    }
    if c == "9" {
        return 9
    }
    if c == "a" {
        return 10
    }
    if c == "b" {
        return 11
    }
    if c == "c" {
        return 12
    }
    if c == "d" {
        return 13
    }
    if c == "e" {
        return 14
    }
    if c == "f" {
        return 15
    }
    if c == "A" {
        return 10
    }
    if c == "B" {
        return 11
    }
    if c == "C" {
        return 12
    }
    if c == "D" {
        return 13
    }
    if c == "E" {
        return 14
    }
    if c == "F" {
        return 15
    }
    -1
}

// Parse one byte from two hex chars; -1 on malformed input.
func colors.hex_byte(hi: str, lo: str) -> int {
    h := colors.hex_val(hi)
    l := colors.hex_val(lo)
    if h < 0 {
        return -1
    }
    if l < 0 {
        return -1
    }
    h * 16 + l
}

// Hex color: "#FF5733", "FF5733", or short "#F53"/"F53".
// Malformed input falls back to the original string unchanged.
//
// Portability notes (VM + AOT share this file):
// - all locals are declared up front — the VM miscompiles bindings first
//   declared after a loop;
// - loops use flat single-level `if`s with int flags only — AOT miscompiles
//   nested `if`s assigning outer vars, and bool locals under `&&` / `!`.
func colors.hex(s: str, code: str) -> str {
    raw := str.split(code, "")
    digits: [str] = []
    c := ""
    skip: int = 0
    i := 0
    n := vec.len(raw)
    count := 0
    while i < n {
        c = raw[i]
        skip = 0
        if c == "" {
            skip = 1
        }
        if c == "#" {
            skip = 1
        }
        if skip == 0 {
            digits = vec.push(digits, c)
        }
        i = i + 1
    }
    count = vec.len(digits)
    if count == 6 {
        return colors.hex6(s, digits)
    }
    if count == 3 {
        return colors.hex3(s, digits)
    }
    s
}

// Six-digit helper for `hex` (no loops: straight-line like `hex_val`).
func colors.hex6(s: str, digits: [str]) -> str {
    a := digits[0]
    b := digits[1]
    r: int = colors.hex_byte(a, b)
    c := digits[2]
    d := digits[3]
    g: int = colors.hex_byte(c, d)
    e := digits[4]
    f := digits[5]
    bch: int = colors.hex_byte(e, f)
    if r < 0 {
        return s
    }
    if g < 0 {
        return s
    }
    if bch < 0 {
        return s
    }
    colors.rgb(s, r, g, bch)
}

// Three-digit helper for `hex`: each nibble is doubled (`F53` → `FF5533`).
func colors.hex3(s: str, digits: [str]) -> str {
    r: int = colors.hex_val(digits[0])
    g: int = colors.hex_val(digits[1])
    b: int = colors.hex_val(digits[2])
    if r < 0 {
        return s
    }
    if g < 0 {
        return s
    }
    if b < 0 {
        return s
    }
    colors.rgb(s, r * 16 + r, g * 16 + g, b * 16 + b)
}

// ── Introspection ────────────────────────────────────────────────────────────

// Strip all `\e[...m` sequences, returning the visible text.
// Flat flag machine (int flags, no nesting, no bool locals): the VM
// miscompiles bindings declared inside nested `while` + `break`, and AOT
// miscompiles nested-`if` assignments and bool locals under `&&` / `!`.
func colors.strip(s: str) -> str {
    chars := str.split(s, "")
    result := ""
    c := ""
    esc: int = 0
    was: int = 0
    i := 0
    n := vec.len(chars)
    while i < n {
        c = chars[i]
        was = esc
        if esc == 1 && c == "m" {
            esc = 0
        }
        if was == 0 && c == "\e" {
            esc = 1
        }
        if was == 0 && c != "\e" && c != "" {
            result = result + c
        }
        i = i + 1
    }
    result
}
