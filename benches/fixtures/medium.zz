    r = r + m73(129, 130) + m74(131, 132) + m75(133, 134) + m76(135, 136) + m77(137, 138)
    r = r + m78(139, 140) + m79(141, 142) + m80(143, 144) + m81(145, 146) + m82(147, 148)
    r = r + m83(149, 150) + m84(151, 152) + m85(153, 154) + m86(155, 156) + m87(157, 158)
    r = r + m88(159, 160) + m89(161, 162) + m90(163, 164) + m91(165, 166) + m92(167, 168)
    r = r + m93(169, 170) + m94(171, 172) + m95(173, 174) + m96(175, 176) + m97(177, 178)
    r = r + m98(179, 180) + m99(181, 182) + m100(183, 184) + m101(185, 186) + m102(187, 188)
    r = r + m103(189, 190) + m104(191, 192) + m105(193, 194) + m106(195, 196) + m107(197, 198)
    r = r + m108(199, 200) + m109(201, 202) + m110(203, 204) + m111(205, 206) + m112(207, 208)
    r = r + m113(209, 210) + m114(211, 212) + m115(213, 214) + m116(215, 216) + m117(217, 218)
    r = r + m118(219, 220) + m119(221, 222) + m120(223, 224)
    t1 := time_mod.now_ms()
    println("medium: {t1 - t0}ms result={r}")
    return r
}
