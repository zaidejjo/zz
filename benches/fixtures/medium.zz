func main() -> int {
    t0 := time_mod.now_ms()
    r := m01(1, 2) + m02(5, 3) * m03(4, 2) / m04(8, 2) % m05(10, 3)
    r = r + m06(0, 0) + m07(1, 2) + m08(3, 4) + m09(5, 6) + m10(7, 8)
    r = r + m11(9, 10) + m12(11, 12) + m13(13, 14) + m14(15, 16) + m15(17, 18)
