import std.time as time_mod

// Big-loop-heavy compile-time fixture: many functions with nested loops.
// Exercises checker control-flow analysis + AOT lowering of loop-heavy code.
// Loop bounds are tiny (safe to run) but the loop structure is deep.

func loop_001(n: int) -> int {
    s := 0
    for a in 0..n {
        for b in 0..n {
            s = s + a + b + 1
        }
    }
    return s
}

