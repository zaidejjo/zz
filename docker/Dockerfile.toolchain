# Pre-built `zz` toolchain image: release binaries on slim Debian.
#
# Published to GHCR by .github/workflows/docker-publish.yml as
#   ghcr.io/<owner>/zz:latest    (latest Release)
#   ghcr.io/<owner>/zz:1.2.3     (release tags + major/minor shorthands)
# `<owner>` follows the repo automatically (`zaidejjo` today,
# `zz-language` after the move) — no hardcoded owner anywhere.
#
# Nothing here compiles: ZZ_VERSION + TARGETARCH select the prebuilt zips
# attached to the GitHub Release (built exactly once by the release
# workflow), and both binaries ship. No Rust toolchain, no QEMU — both
# architectures are plain file copies.
#
# Downstream services (zz-registry) use this as a base image instead of
# compiling the toolchain themselves:
#   FROM ghcr.io/<owner>/zz:latest AS tool
#
# Local build (needs network for the Release zips):
#   docker build -f docker/Dockerfile.toolchain --build-arg ZZ_VERSION=0.1.5 -t zz:local .

ARG TARGETARCH
ARG ZZ_VERSION
ARG GITHUB_REPOSITORY=zaidejjo/zz

FROM debian:bookworm-slim
ARG TARGETARCH
ARG ZZ_VERSION
ARG GITHUB_REPOSITORY
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip libssl3 && rm -rf /var/lib/apt/lists/*
# Release zips are per-arch; map Docker arches onto their names.
RUN case "$TARGETARCH" in \
        amd64) ZZARCH=x86_64 ;; \
        arm64) ZZARCH=aarch64 ;; \
        *) echo "error: unsupported arch '$TARGETARCH'" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/${GITHUB_REPOSITORY}/releases/download/v${ZZ_VERSION}/zz-${ZZ_VERSION}-linux-${ZZARCH}.zip" -o /tmp/zz.zip && \
    unzip -p /tmp/zz.zip zz > /usr/local/bin/zz && \
    unzip -p /tmp/zz.zip zz-lsp > /usr/local/bin/zz-lsp && \
    chmod +x /usr/local/bin/zz /usr/local/bin/zz-lsp && \
    rm /tmp/zz.zip && \
    zz --version
ENTRYPOINT ["zz"]
CMD ["--version"]
