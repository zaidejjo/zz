# Pre-built `zz` toolchain image: release CLI binary on slim Debian.
#
# Published to GHCR by .github/workflows/docker-publish.yml as
#   ghcr.io/<owner>/zz:latest   (main branch)
#   ghcr.io/<owner>/zz:vX.Y.Z   (release tags)
# `<owner>` follows the repo automatically (`zaidejjo` today,
# `zz-language` after the move) — no hardcoded owner anywhere.
#
# Downstream services (zz-registry) use this as a base image instead of
# compiling the toolchain themselves:
#   FROM ghcr.io/<owner>/zz:latest AS tool
#
# Local build: docker build -f docker/Dockerfile.toolchain -t zz:local .

FROM rust:1-bookworm AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang pkg-config libssl-dev git binutils && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
WORKDIR /src

# Planner: dependency recipe (reruns only when Cargo.toml/lock change).
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Cacher: compile third-party deps once (cached as a layer until the
# recipe changes). Works on any builder; GHA layer cache (type=gha in
# the workflow) persists it across CI runs.
FROM chef AS cacher
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --locked --profile release --recipe-path recipe.json

# Build: sources only — dependencies come from the cached layer above,
# so reruns recompile just our crates.
FROM cacher AS build
COPY . .
# Locked, release profile: the exact binary CI tested. Stripped: debug
# symbols stay in the workspace profile (profiling-friendly) but have no
# place in a production image (~230MB saved).
RUN cargo build --locked --profile release --bin zz \
    && mkdir -p /opt/zz-bin \
    && cp target/release/zz /opt/zz-bin/zz \
    && strip /opt/zz-bin/zz \
    && /opt/zz-bin/zz --version
# Promote out of target/ (keeps the final COPY obvious).
RUN mkdir -p /opt/zz/bin && cp /opt/zz-bin/zz /opt/zz/bin/zz \
    && rm -rf /opt/zz-bin

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/zz/bin/zz /usr/local/bin/zz
ENTRYPOINT ["zz"]
CMD ["--version"]
