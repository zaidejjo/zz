# Pre-built `zz` toolchain image: release binaries on Ubuntu 24.04.
#
# Published to GHCR (and mirrored to Docker Hub) by
# .github/workflows/docker-publish.yml as
#   ghcr.io/<owner>/zz:latest    (latest Release)
#   ghcr.io/<owner>/zz:1.2.3     (release tags + major/minor shorthands)
#   ghcr.io/<owner>/zz:1.2.3-builder  (AOT build environment)
#   ghcr.io/<owner>/zz:1.2.3-runtime  (AOT runtime libraries)
#   <dockerhub-user>/zz:latest, :1.2.3, … (same tags on Docker Hub)
# `<owner>` follows the repo automatically (`zaidejjo` today,
# `zz-language` after the move) — no hardcoded owner anywhere.
#
# Nothing here compiles: ZZ_VERSION + TARGETARCH select the prebuilt zips
# attached to the GitHub Release (built exactly once by the release
# workflow), and both binaries ship. No Rust toolchain, no QEMU — both
# architectures are plain file copies.
#
# Application images should not install Clang themselves. Use the matching
# split images instead:
#   FROM ghcr.io/<owner>/zz:<version>-builder AS build
#   FROM ghcr.io/<owner>/zz:<version>-runtime
# This toolchain image remains the base for CLI-only use and for the builder
# image, which copies `zz`/`zz-lsp` out of it:
#   FROM ghcr.io/<owner>/zz:latest AS tool
#
# Local build (needs network for the Release zips):
#   docker build -f docker/Dockerfile.toolchain --build-arg ZZ_VERSION=0.4.0 -t zz:local .

ARG TARGETARCH
ARG ZZ_VERSION
ARG GITHUB_REPOSITORY=zaidejjo/zz

# NOTE: keep this distro in lockstep with the release builders
# (ubuntu-latest / ubuntu-24.04-arm in release.yml): the prebuilt zips
# link the builders' glibc, and a base with an OLDER glibc fails at
# `zz --version` with `GLIBC_X.YY not found`. If runners move on
# (e.g. ubuntu-26.04), bump this base to match.
#
# Pinned by digest (`ubuntu:24.04` at 2026-10-21), same as the builder and
# runtime images. Refresh with `docker buildx imagetools inspect ubuntu:24.04`
# and update all three Dockerfiles in one commit.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ARG TARGETARCH
ARG ZZ_VERSION
ARG GITHUB_REPOSITORY
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip libssl3t64 && rm -rf /var/lib/apt/lists/*
# Release zips are per-arch; map Docker arches onto their names. buildx sets
# TARGETARCH for every platform it builds; plain `docker build` leaves it
# empty, so fall back to the host architecture (the documented local flow).
#
# AOT builds link the shipped `libzz_native_rt.a` (+ static libstd rlib). The
# compiler looks in `<exe>/lib` and `<exe>/../lib/zz`, so the archive has to
# land on the AUR layout at /usr/local/lib/zz. Dropping `lib/` makes every
# `zz build` fail with "cannot locate workspace".
#
# Only the two linking artifacts are installed: release zips also carry the
# bundled Zig toolchain (`lib/std`, `lib/libc`, …) because `zig` resolves
# them from `<exe>/lib`, but this image has no `zig` binary — the builder
# image uses system Clang — so copying that tree would add ~150MB of dead
# weight to every pull.
RUN case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) ZZARCH=x86_64 ;; \
        arm64|aarch64) ZZARCH=aarch64 ;; \
        *) echo "error: unsupported arch '${TARGETARCH:-$(uname -m)}'" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/${GITHUB_REPOSITORY}/releases/download/v${ZZ_VERSION}/zz-${ZZ_VERSION}-linux-${ZZARCH}.zip" -o /tmp/zz.zip && \
    mkdir -p /tmp/zzdist && unzip -q /tmp/zz.zip -d /tmp/zzdist && \
    install -m755 /tmp/zzdist/zz /tmp/zzdist/zz-lsp /usr/local/bin/ && \
    mkdir -p /usr/local/lib/zz && \
    cp -a /tmp/zzdist/lib/libzz_native_rt.a /tmp/zzdist/lib/libstd-*.rlib /usr/local/lib/zz/ && \
    rm -rf /tmp/zzdist /tmp/zz.zip && \
    zz --version
ENTRYPOINT ["zz"]
CMD ["--version"]
