import std.task
import std.chan
import std.time

func main() {
    c1 := std.chan()
    c2 := std.chan()
    task.spawn(|_| {
        for i in 0..20000 {
            v := 0
            v = std.chan.recv(c1)
            std.chan.send(c2, v + 1)
        }
    })
    t0 := time.now_nanos()
    last := 0
    for i in 0..20000 {
        std.chan.send(c1, i)
        last = std.chan.recv(c2)
    }
    t1 := time.now_nanos()
    el := t1 - t0
    per := el / 20000
    println("pingpong elapsed_ns={el} last={last} ns_per_rt={per}")

    c := std.chan()
    t2 := time.now_nanos()
    for i in 0..10000 {
        task.spawn(|_| {
            std.chan.send(c, i)
        })
    }
    sum := 0
    for i in 0..10000 {
        v := 0
        v = std.chan.recv(c)
        sum = sum + v
    }
    t3 := time.now_nanos()
    fspan := t3 - t2
    ns_per_task := fspan / 10000
    tput := 1000000000 / ns_per_task
    println("fanin elapsed_ns={fspan} sum={sum} tasks_per_s={tput}")
    println("bench_handoff_ok")
}
