// bench/phase1/encoding_url_encode.zz — benchmark URL encode
import std.encoding
import std.fs
import std.time

func main() -> int {
    data := fs.read("/home/zaid/Projects/.zz-targets/bench-hex-data.txt") ?? ""
    t0 := time.now_ms()
    h := encoding.url_encode(data)
    t1 := time.now_ms()
    println("url_encode n={len(data)} ms={t1 - t0} out_len={len(h)}")
    return 0
}
