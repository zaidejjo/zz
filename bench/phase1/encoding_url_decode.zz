// bench/phase1/encoding_url_decode.zz — benchmark URL decode
import std.encoding
import std.fs
import std.time

func main() -> int {
    url := fs.read("/home/zaid/Projects/.zz-targets/bench-url-str.txt") ?? ""
    t0 := time.now_ms()
    d := encoding.url_decode(url) ?? ""
    t1 := time.now_ms()
    println("url_decode n={len(url)} ms={t1 - t0} out_len={len(d)}")
    return 0
}
