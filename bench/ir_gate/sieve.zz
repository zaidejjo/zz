func main() {
    n := 200000
    is_prime := []
    for i in 0..n {
        is_prime = vec.push(is_prime, true)
    }
    is_prime[0] = false
    is_prime[1] = false
    count := 0
    for i in 2..n {
        if is_prime[i] {
            count = count + 1
            j := i * 2
            while j < n {
                is_prime[j] = false
                j = j + i
            }
        }
    }
    println(count)
}
