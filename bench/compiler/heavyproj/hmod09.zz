pub func hmod09_f0(x: int) -> int {
    a := x + 0
    b := a * 2 + x
    c := b - a + 0 * 3
    d := c + b - a
    e := match d {
        0 => x,
        1 => a + b,
        _ => c + d + a + b,
    }
    f := e + d - c + b - a + x
    g := f * 2 + e - d
    return g + f - e + d - c + b - a
}
