// AU1 verdict-clobber: green task T2 whose TRAILING op is a send that hands
// off to waiter T3, which re-suspends. If the inline run's verdict=1 leaks
// into T2's run, the trampoline drops T2's completion and try_join never
// fires. Expected: verdict_ok. Buggy: verdict_stale (hang-free detector).
import std.task
import std.chan
import std.time

func main() {
    chA := std.chan()
    chB := std.chan()
    chZ := std.chan()
    std.chan.send(chZ, 5)
    h3 := task.spawn(|_| {
        x := 0
        x = std.chan.recv(chA)
        y := 0
        y = std.chan.recv(chB)
        x + y
    })
    time.sleep_ms(300)
    h2 := task.spawn(|_| {
        w := 0
        w = std.chan.recv(chZ)
        std.chan.send(chA, w)
    })
    done := 0
    for i in 0..200000 {
        q := task.try_join(h2)
        if let .some(v) = q {
            done = 1
            break
        }
    }
    println("h2_done={done}")
    if done == 1 {
        println("verdict_ok")
    } else {
        println("verdict_stale")
    }
}
