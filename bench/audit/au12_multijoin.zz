// AU12 multi-joiner, refcounted result: TWO tasks join the same
// array-yielding handle. If both completions alias one payload without
// retain, scope-end releases double-free (ASan probe).
import std.task
import std.time

func pick(h) {
    a: [int] = task.join(h)
    a[1]
}

func main() {
    h := task.spawn(|_| { [1, 2, 3] })
    h2 := task.spawn(|_| {
        pick(h)
    })
    b: [int] = task.join(h)
    q: int = task.join(h2)
    println("m={q} n={b[0]}")
    if q == 2 {
        println("multijoin_ok")
    }
}
