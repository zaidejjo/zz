// AU10 rich captures: string + array + dict + int through the fused
// spawn-dup + block pool path. 5 + 42 + 7 = 54.
import std.task
import std.chan

func main() {
    s := "hello-world"
    arr := [1, 2, 3, 4, 5]
    d := {"k": 42}
    n := 7
    c := std.chan()
    h := task.spawn(|_| {
        std.chan.send(c, arr[4] + d["k"] + n)
    })
    v := 0
    v = std.chan.recv(c)
    println("v={v} s={s}")
    if v == 54 {
        println("bigcap_ok")
    }
}
