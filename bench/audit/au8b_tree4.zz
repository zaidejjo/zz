// AU8 tree: recursive spawn+join, depth 7 (255 tasks). Exercises nested
// spawn from workers, blocking join on workers (top-up path), green
// verdict on join-heavy closures.
import std.task

func t(n: int) -> int {
    if n <= 0 {
        return 1
    }
    left := task.spawn(|_| { t(n - 1) })
    right := t(n - 1)
    a: int = task.join(left)
    a + right
}

func main() {
    r := t(4)
    println("tree={r}")
    if r == 16 {
        println("tree_ok")
    }
}
