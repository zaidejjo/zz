// AU3 MPMC: 8 senders x 1000 msgs, 2 receiver tasks, sum must be 8000.
import std.task
import std.chan

func main() {
    c := std.chan()
    for s in 0..8 {
        task.spawn(|_| {
            for k in 0..1000 {
                std.chan.send(c, 1)
            }
        })
    }
    out := std.chan()
    for r in 0..2 {
        task.spawn(|_| {
            part := 0
            for k in 0..4000 {
                v := 0
                v = std.chan.recv(c)
                part = part + v
            }
            std.chan.send(out, part)
        })
    }
    total := 0
    for r in 0..2 {
        v := 0
        v = std.chan.recv(out)
        total = total + v
    }
    println("total={total}")
    if total == 8000 {
        println("mpmc_ok")
    }
}
