// AU5 relay cascade: 30 green tasks chained by channels. Each resume
// synchronously triggers the next, so inline nesting exceeds the depth
// cap of 8 — the queue fallback MUST still deliver every hop.
import std.task
import std.chan

func main() {
    cur := std.chan()
    first := cur
    for i in 0..30 {
        prev := cur
        nxt := std.chan()
        task.spawn(|_| {
            v := 0
            v = std.chan.recv(prev)
            std.chan.send(nxt, v + 1)
        })
        cur = nxt
    }
    std.chan.send(first, 0)
    last := 0
    last = std.chan.recv(cur)
    println("relay={last}")
    if last == 30 {
        println("relay_ok")
    }
}
