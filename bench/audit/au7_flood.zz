// AU7 flood: 50k sends with no receiver (unbounded spill), then full
// drain. Sum(0..49999) = 1249975000.
import std.chan

func main() {
    c := std.chan()
    for i in 0..50000 {
        std.chan.send(c, i)
    }
    sum := 0
    for i in 0..50000 {
        v := 0
        v = std.chan.recv(c)
        sum = sum + v
    }
    println("sum={sum}")
    if sum == 1249975000 {
        println("flood_ok")
    }
}
