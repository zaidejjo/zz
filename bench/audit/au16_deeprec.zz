// AU16 deep recursion inside a task: 100k-deep ZZ call recursion.
// Worker stacks are 1MB C stacks; documents the recursion depth limit.
import std.task

func down(n: int) -> int {
    if n <= 0 {
        return 0
    }
    down(n - 1) + 1
}

func main() {
    h := task.spawn(|_| { down(100000) })
    r: int = task.join(h)
    println("deep={r}")
    if r == 100000 {
        println("deeprec_ok")
    }
}
