// AU6 thrash: 300x channel alloc + ping-pong + drop. Stresses the
// rep block pool recycle path and allocator steady-state.
import std.task
import std.chan

func main() {
    last := 0
    for i in 0..300 {
        c1 := std.chan()
        c2 := std.chan()
        task.spawn(|_| {
            v := 0
            v = std.chan.recv(c1)
            std.chan.send(c2, v + 1)
        })
        std.chan.send(c1, i)
        last = std.chan.recv(c2)
    }
    println("last={last}")
    if last == 300 {
        println("thrash_ok")
    }
}
