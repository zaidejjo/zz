// AU15 pool overflow: 1000-int capture (~8KB) exceeds the largest pool
// bucket (8192 incl. header) -> overflow exact-malloc + checkin-free path.
import std.task
import std.chan

func main() {
    arr := [x for x in range(0, 1000)]
    c := std.chan()
    h := task.spawn(|_| {
        std.chan.send(c, arr[999] + arr[0])
    })
    v := 0
    v = std.chan.recv(c)
    println("big={v}")
    if v == 999 {
        println("bigpool_ok")
    }
}
