// AU20 variable loop bound across suspends: `0..n` with a captured n.
// The bound is re-read every iteration — without a frame spill it reads
// a dead C stack slot after resume (same class as au3's literal bound).
import std.task
import std.chan

func main() {
    n := 5000
    c := std.chan()
    h := task.spawn(|_| {
        total := 0
        for i in 0..n {
            v := 0
            v = std.chan.recv(c)
            total = total + v
        }
        total
    })
    for i in 0..5000 {
        std.chan.send(c, 1)
    }
    r: int = task.join(h)
    println("vartrip={r}")
    if r == 5000 {
        println("vartrip_ok")
    }
}
