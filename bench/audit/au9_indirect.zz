// AU9 indirect recv: green task calls a NAMED function that blocks in
// recv (non-green path -> thread park + top-up replacement). Must
// complete: proves the blocking fallback stays correct under green tasks.
import std.task
import std.chan
import std.time

func get(c) {
    v := 0
    v = std.chan.recv(c)
    v + 100
}

func main() {
    c := std.chan()
    h := task.spawn(|_| {
        get(c)
    })
    time.sleep_ms(200)
    std.chan.send(c, 23)
    r: int = task.join(h)
    println("indirect={r}")
    if r == 123 {
        println("indirect_ok")
    }
}
