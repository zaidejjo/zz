// =====================================================================
// bench_string_concats.zz
// Multi-language stress benchmark — ZZ implementation.
//
// Heavy string concatenation in many short rounds to exercise the
// allocator and measure peak memory footprint. Each round is released
// before the next begins so a healthy runtime should peak at
// O(max round size), not O(total bytes).
//
// Workload:
//   * 50 rounds × 5000 single-char appends  →  250k chars
//   * 20 rounds × 2000 multi-char appends   →  ~80k chars per round
//   * final round: build a 10000-char string via repeated concat
// =====================================================================

import std.time

func main() {
    t0 := time.now_ms()

    // ── Round 1: 50 × 5000 single-char appends ──────────────────────
    round_sum := 0
    for r in 0..50 {
        s := ""
        for i in 0..5000 {
            s = s + "a"
        }
        round_sum = round_sum + len(s)
    }
    t1 := time.now_ms()
    println("round1_50x5000_ms: " + str(t1 - t0))
    println("round1_chars: " + str(round_sum))

    // ── Round 2: 20 × 2000 multi-char appends ───────────────────────
    round_sum = 0
    for r in 0..20 {
        s := ""
        chunk := "hello-"
        for i in 0..2000 {
            s = s + chunk
        }
        round_sum = round_sum + len(s)
    }
    t2 := time.now_ms()
    println("round2_20x2000_ms: " + str(t2 - t1))
    println("round2_chars: " + str(round_sum))

    // ── Round 3: one 10000-char string via repeated concat ───────────
    s := ""
    for i in 0..10000 {
        s = s + "x"
    }
    t3 := time.now_ms()
    println("round3_10000_ms: " + str(t3 - t2))
    println("round3_chars: " + str(len(s)))

    // ── Final stats ──────────────────────────────────────────────────
    t4 := time.now_ms()
    final_len := len(s)
    total_chars := round_sum * 2 + final_len
    println("total_ms: " + str(t4 - t0))
    println("signature_total_chars: " + str(total_chars))
    println("bench_string_concats_ok")
}