// examples/rest_api_server.zz — Mini REST API with JSON responses
import std.json
import std.http

println("REST API Server starting...")

// Create server with routes
s := http.server()
s2 := http.route_get(s, "/", |_path: str| "Welcome to the ZZ REST API!")
s3 := http.route_get(s2, "/health", |_path: str| "{\"status\": \"ok\"}")
s4 := http.route_get(s3, "/items", |_path: str| "[{\"id\": 1, \"name\": \"Widget\"}, {\"id\": 2, \"name\": \"Gadget\"}]")
s5 := http.route_post(s4, "/items", |body: str| "Created: {body}")
s6 := http.route_put(s5, "/items", |body: str| "Updated: {body}")
s7 := http.route_delete(s6, "/items", |_path: str| "Deleted")

// Simulate some requests
println("=== Simulated API Requests ===")

match http.handle(s7, "GET", "/", "") {
    .ok(v) => println("GET /    -> {v}"),
    .err(e) => println("ERROR: {e}"),
}

match http.handle(s7, "GET", "/health", "") {
    .ok(v) => println("GET /health -> {v}"),
    .err(e) => println("ERROR: {e}"),
}

match http.handle(s7, "GET", "/items", "") {
    .ok(v) => println("GET /items  -> {v}"),
    .err(e) => println("ERROR: {e}"),
}

match http.handle(s7, "POST", "/items", "{\"name\": \"NewItem\"}") {
    .ok(v) => println("POST /items -> {v}"),
    .err(e) => println("ERROR: {e}"),
}

match http.handle(s7, "DELETE", "/items", "") {
    .ok(v) => println("DELETE /items -> {v}"),
    .err(e) => println("ERROR: {e}"),
}

// 404 handling
match http.handle(s7, "GET", "/notfound", "") {
    .ok(v) => println("ERROR: should have been 404"),
    .err(_e) => println("GET /notfound -> 404 (expected)"),
}

println("rest_api_server_done")
