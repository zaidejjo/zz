// features: comparison, func-call, int-arith, locals, print, pub-visibility, structs
// Test: pub struct and method together.
pub struct Point {x: int, y: int}

pub func dist(p: Point) -> int {
    p.x + p.y
}

func main() {
    p := Point{x: 3, y: 4}
    println(dist(p))
    println("pub_struct_method_ok")
}
