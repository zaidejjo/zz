// features: comparison, func-call, int-arith, print, pub-visibility
// Test: pub import re-export with alias.
// Full multi-file test is in loader/tests.rs (pub_reexport_alias_with_struct).

pub func add(a: int, b: int) -> int {
    a + b
}

func main() {
    println(add(3, 4))
    println("pub_reexport_alias_ok")
}
