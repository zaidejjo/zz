// E2E: Basic @test assertions — assert, assert_eq, assert_ne, assert_approx_eq
import std.math

@test
func test_assert_true() {
    assert(true)
    println("assert(true) ok")
}

@test
func test_assert_eq_int() {
    assert_eq(1 + 1, 2)
    assert_eq(0, 0)
    assert_eq(-1, -1)
    println("assert_eq(int) ok")
}

@test
func test_assert_eq_str() {
    assert_eq("hello", "hello")
    assert_eq("", "")
    println("assert_eq(str) ok")
}

@test
func test_assert_ne() {
    assert_ne(1, 2)
    assert_ne("a", "b")
    println("assert_ne ok")
}

@test
func test_assert_approx_eq() {
    assert_approx_eq(1.0, 1.0001, 0.01)
    assert_approx_eq(0.0, 0.0, 0.0)
    println("assert_approx_eq ok")
}

@test
func test_assert_with_bare_name() {
    x := 42
    assert(x == 42)
    assert_eq(x, 42)
    println("bare name assertions ok")
}

println("all_basic_assertions_ok")
