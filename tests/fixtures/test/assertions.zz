// E2E: All assertion types work correctly

@test
func test_assert_basic() {
    assert(true)
    assert(1 == 1)
    assert("hello" == "hello")
}

@test
func test_assert_eq() {
    assert_eq(1 + 1, 2)
    assert_eq("hello", "hello")
    assert_eq(true, true)
}

@test
func test_assert_ne() {
    assert_ne(1, 2)
    assert_ne("a", "b")
    assert_ne(true, false)
}

@test
func test_assert_approx_eq() {
    assert_approx_eq(0.1 + 0.2, 0.3, 0.0001)
    assert_approx_eq(1.0, 1.0, 0.0)
}

println("test_framework_ok")
