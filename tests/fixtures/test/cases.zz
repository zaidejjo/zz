// E2E: Parameterized test cases expand into individual tests

func double(x: int) -> int {
    x + x
}

@test(cases = [[1, 2], [2, 4], [3, 6], [10, 20]])
func test_double(x: int, expected: int) {
    assert_eq(double(x), expected)
}

func is_positive(n: int) -> bool {
    n > 0
}

@test(cases = [[1, true], [-1, false], [0, false]])
func test_is_positive(n: int, expected: bool) {
    assert_eq(is_positive(n), expected)
}

println("test_framework_ok")
