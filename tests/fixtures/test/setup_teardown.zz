// E2E: @setup and @teardown run before/after each test
setup_counter := 0

@setup
func setup() {
    setup_counter = 0
}

@teardown
func teardown() {
    setup_counter = 0
}

@test
func test_setup_resets() {
    assert(setup_counter == 0)
    setup_counter = 99
}

@test
func test_setup_runs_each_time() {
    // setup_counter should be 0 again because @setup ran
    assert(setup_counter == 0)
}

println("test_framework_ok")
