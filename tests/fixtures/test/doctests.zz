// features: assert, comparison, func-call, int-arith, locals, string-literal, zz-test
// E2E: doc-tests — /// ```zz fences run as tests on both engines.

/// Double a number.
///
/// ```zz
/// assert_eq(double(21), 42)
/// ```
///
/// ```zz,ignore
/// assert_eq(double(0), 999)
/// ```
func double(n: int) -> int {
    n * 2
}

/// Always true.
///
/// ```zz
/// assert(true)
/// ```

func truthy() -> bool {
    true
}

@test
func test_double() {
    assert_eq(double(2), 4)
    assert(truthy())
}
