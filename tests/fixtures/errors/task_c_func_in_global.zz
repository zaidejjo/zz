// features: int-arith, locals, print, state, std-task
// Task C: function stored in a global that touches a plain global → Z0017.
import std.task

state_counter := 0 // plain mutable global reachable from a task → Z0017

func touched_global() -> int {
    state_counter = state_counter + 1
    return state_counter
}

handler := touched_global // address-taken: global holds a func value

func main() -> int {
    h := task.spawn(|_| {
        handler()
    })
    // calls the stored func inside a task
    task.join(h)
    return 0
}
