// features: bool-logic, comparison, error-case, func-call, if-else, print, return, string-literal
// E2E: divergent `return` must not mask a wrong-typed join.
// The `else` value path yields `str` in a `-> int` function.
func f(c: bool) -> int {
    return if c {
        return 1
    } else {
        "hi"
    }
}
println(f(true))
