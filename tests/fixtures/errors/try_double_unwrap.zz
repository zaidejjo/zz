// Redundant double-unwrap is a compile error: `?` binds first (postfix is
// tighter), so `try fetch()?` is `try(fetch()?)` — the outer `try` sees the
// already-unwrapped `int`, not a `Result`.
func fetch() -> Result<int, str> {
    .ok(1)
}

func load() -> Result<int, str> {
    x := try fetch()?
    .ok(x)
}
