// features: bool-logic, comparison, error-case, func-call, if-else, print, return, string-literal
// E2E: even an explicit annotation on the join must be enforced —
// `Never` must not absorb the declared type.
func f(c: bool) -> int {
    x: int = if c { return 1 } else { "hi" }
    x
}
println(f(false))
