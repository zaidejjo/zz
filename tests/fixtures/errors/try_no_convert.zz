// features: comparison, error-case, func-call, locals, option-result, structs, try-question
// Mismatched error types with no Convert impl is a compile error.
struct ErrA { msg: str }
struct ErrB { msg: str }

func fetch() -> Result<int, ErrA> {
    .ok(1)
}

func load() -> Result<int, ErrB> {
    x := try fetch()
    .ok(x)
}
