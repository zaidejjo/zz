// features: comparison, func-call, imports, int-arith, locals, pipe, print, std-str, string-literal
// E2E: Pipeline operator |>

// basic pipeline

// pipeline with method-like call
import std.str

// E2E: Pipeline operator |>

func double(n: int) -> int {
    return n * 2
}

func add_one(n: int) -> int {
    return n + 1
}

func negate(n: int) -> int {
    return -n
}

// basic pipeline
r1 := 5 |> double |> add_one
println(r1)
greeting := "hello world" |> str.to_upper
println(greeting)

// pipeline across lines
result := 10
    |> double
    |> add_one
    |> double
println(result)

// pipeline with comments between links (#489): comment-only lines are
// trivia and must not terminate the chain
commented := 5
    // double it
    |> double
    /* then bump it */
    |> add_one // trailing comment stays on its link
    |> double
println(commented)

println("pipe_ok")
