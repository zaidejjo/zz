// features: closures, structs, arrays, capture-by-reference, int-arith, print, string-literal
// Closures capturing struct and array values by reference.
struct Point {
    x: int,
    y: int,
}
rec := Point{x: 3, y: 4}
f := |d: int| {
    rec.x + rec.y + d
}
arr := [10, 20, 30]
g := |i: int| {
    arr[i] + 1
}
println(f(1)) // 3 + 4 + 1 = 8
println(g(0)) // 10 + 1 = 11
println("closure_capture_struct_array_ok")
