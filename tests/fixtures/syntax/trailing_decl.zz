// features: arrays, assert, comparison, for-loop, func-call, int-arith, locals, print, string-literal, while-loop
// Trailing declarations: a block ending in `:=` keeps the declared value
// as slot storage, so cleanup pops one fewer value. Regression: the VM
// compiler emitted PopN(n) for n stack values (subtract overflow / silent
// corruption in release).
func tail_decl() -> int {
    x := 1
    y := x + 2
    return y
}

// Unit functions may still end in a declaration; this keeps the VM's
// block-cleanup path (a trailing `:=` leaves slot storage) covered.

func tail_decl_unit() {
    x := 1
    _y := x + 2
}

func block_tail() -> int {
    v := {
        a := 10
        b := a * 2
    }
    return v + 1
}

func loop_tail() -> int {
    total := 0
    for i in [1, 2, 3] {
        total = total + i
        tmp := total * 10
    }
    return total
}

func while_tail() -> int {
    n := 0
    while n < 3 {
        n = n + 1
        dbl := n * 2
    }
    return n
}

func main() {
    tail_decl_unit()
    assert_eq(tail_decl(), 3)
    assert_eq(block_tail(), 21)
    assert_eq(loop_tail(), 6)
    assert_eq(while_tail(), 3)
    println("trailing_decl_ok")
}
