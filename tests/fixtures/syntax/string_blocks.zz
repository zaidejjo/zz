// E2E: String comparison before block statements (regression: parser ambiguity)
// Ensures "zaid"{ } is NOT treated as string interpolation.
// Now tests actual string == comparisons (VM supports string equality).
name1 := "Zaid"
name2 := "Ali"

// Parse correctly: string comparison before multi-line block
if name1 == "Zaid" {
    println("first branch")
}

// Parse correctly: string comparison before single-line block
if name2 == "Ali" { println("second branch") }

// Parse correctly: string comparison with else block
if name1 == "nobody" {
    println("should not print")
} else {
    println("else branch")
}

// Unspaced: string comparison immediately before block (no whitespace)
if name1 == "Zaid"{ println("unspaced if") }

// Unspaced: else block directly after }
if name1 == "nobody" {
    println("nope")
}else{
    println("unspaced else")
}

// while with string comparison
s := "start"
count := 0
while count < 1 {
    println("looping")
    count = count + 1
}

println("str_block_ok")
