// features: comparison, func-call, if-else, int-arith, print, recursion, string-literal
// E2E: Function definitions, default params, named args
func add(a: int, b: int) -> int {
    return a + b
}

func greet(name: str, prefix: str = "Hello") -> str {
    return "{prefix}, {name}!"
}

func fib(n: int) -> int {
    return if n <= 1 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

println("func_ok")
println(add(3, 4))
println(greet("World"))
println(greet("ZZ", prefix: "Hi"))
println(fib(10))
