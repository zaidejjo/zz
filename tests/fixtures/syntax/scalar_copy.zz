// E2E: scalar-to-scalar copies must lower to raw C on the native backend.
// `s := sx` (Decl) and `s = sy` (Assign) between raw scalar locals once
// miscompiled to `(v).f` on a plain double. Both engines must agree.

func fit(cur_w: int, cur_h: int, want_w: int, want_h: int) -> float {
    sx := float(want_w) / float(cur_w)
    sy := float(want_h) / float(cur_h)
    s := sx
    if sy < sx {
        s = sy
    }
    s
}

func pick(a: int, b: int, cond: bool) -> int {
    x := a
    if cond {
        x = b
    }
    x
}

r1 := fit(640, 480, 320, 240)
if r1 == 0.5 {
    println("fit half")
} else {
    println("BAD fit1")
}

r2 := fit(640, 480, 200, 200)
if r2 == 0.3125 {
    println("fit min")
} else {
    println("BAD fit2")
}

println(pick(10, 20, true))
println(pick(10, 20, false))

println("scalar_copy_ok")
