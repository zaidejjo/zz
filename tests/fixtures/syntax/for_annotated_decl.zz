// Annotated declarations inside block bodies: `for`/`if` braces must not
// swallow a leading `name: Type = ...` as a struct literal.
hs := [1, 2, 3]
total := 0
for h in hs {
    r: int = h * 2
    total = total + r
}
println(total)
if total == 12 {
    w: int = 100
    println(w)
}
println("for_annotated_decl_ok")
