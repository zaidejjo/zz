// E2E: ? and ?? operators handle newlines correctly.
// The newline after ?? must NOT eat the next statement.
// ?? multiline continuation (operator spans lines) must still work.

x := 1
y := x ??
    2
println(y)

// Verify two separate ?? expressions on separate lines
// don't merge into one expression.
a := 10 ?? 0
b := 20 ?? 0
println(a + b)

println("question_newline_ok")
