// features: comparison, func-call, int-arith, known-divergence, locals, methods, print, string-literal, struct-methods
// E2E: extension methods on builtins (`impl str`, `impl int`).
impl str {
    func shout(self) -> str {
        self.to_upper()
    }
}

impl int {
    func double(self) -> int {
        self * 2
    }
}

println("hi".shout())
x := 21
println(x.double())
println((21).double())
println("extension_methods_ok")
