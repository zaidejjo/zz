// E2E: explicit compile-time decorators (logging, route, login_required)

// Logging middleware: wraps any `func(str) -> str`.
func logging(f: func(str) -> str) -> func(str) -> str {
    return |name: str| {
        println("enter")
        r := f(name)
        println("exit")
        r
    }
}

// Route registration: target passed explicitly first.
func route(f: func(str) -> str, path: str) -> func(str) -> str {
    return |name: str| {
        println("route {path}")
        f(name)
    }
}

authed := false

// Auth gate middleware.
func login_required(f: func(str) -> str) -> func(str) -> str {
    return |name: str| {
        if authed {
            f(name)
        } else {
            "denied"
        }
    }
}

@logging
func hello(name: str) -> str {
    "hi {name}"
}

@logging
@route("/hello")
func stacked(name: str) -> str {
    "hi {name}"
}

@login_required
func secret(name: str) -> str {
    "secret for {name}"
}

// Method decorators receive the method value (including `self`) explicitly.
func mlogging(f: func(Box, str) -> str) -> func(Box, str) -> str {
    return |s: Box, name: str| {
        println("m-enter")
        r := f(s, name)
        println("m-exit")
        r
    }
}

struct Box { tag: str }

impl Box {
    @mlogging
    func show(self, name: str) -> str {
        "box {self.tag} {name}"
    }
}

println(hello("bob"))
println(stacked("bob"))
println(secret("bob"))
authed = true
println(secret("bob"))
b := Box { tag: "t" }
println(b.show("bob"))
println("decorators_ok")
