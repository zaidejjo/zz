// features: arrays, func-call, indexing, locals, print, string-literal, vec-push
// E2E: plain index-store side-effect order (spec §7: base, index,
// value, left-to-right). Both engines must log [1, 2]. Strict since
// the zzc-codec slice fixed the VM plain-store path to source order.
log := []
func rec(n: int) -> int {
    log = vec.push(log, n)
    n
}
a := [10, 20, 30]
a[rec(1)] = rec(2)
println("a={a}")
println("log={log}")
println("edge_index_store_order_ok")
