// features: arrays, func-call, indexing, locals, print, string-literal, vec-push
// E2E: compound index store evaluates each side exactly once.
// Regression: the AOT compound path briefly emitted the index expression
// twice (get + set), firing side effects twice. Both engines log [1, 2].
log := []
func rec(n: int) -> int {
    log = vec.push(log, n)
    n
}
a := [10, 20, 30]
a[rec(1)] += rec(2)
println("a={a}")
println("log={log}")
println("edge_compound_index_eval_ok")
