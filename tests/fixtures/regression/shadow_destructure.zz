// features: bool-logic, destructuring, if-else, locals, print, string-literal, tuples
// Regression: shadowing re-destructuring inside a block must resolve
// to the outer binding afterwards, on both engines.
(a, _b) := (1, 2)
if true {
    (a, _c) := (10, 20)
    println(a)
}
println(a)
println("shadow_destructure_ok")
