// features: arrays, assert, comparison, for-loop, indexing, locals, print, ranges, string-literal, vec-push
// VM + native: assign-form `vec.push` returns the new array on both
// engines (push is `vec.push` plus the method form `xs.push(x)` — the
// old `vec.append` / bare `append` spellings were removed).
d := []
for i in 0..5 {
    d = vec.push(d, i)
}
assert(len(d) == 5)
assert(d[4] == 4)
// Method spelling agrees.
e := [1]
e.push(2)
assert(len(e) == 2)
assert(e[1] == 2)
println("move_append_append_ok")
