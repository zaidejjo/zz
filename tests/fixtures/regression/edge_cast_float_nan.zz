// features: casts, imports, nondeterministic, print, std-math, string-literal
// E2E: edge — int(NaN). DIVERGENCE: VM and native -O0 print 0, but
// native -O3 prints MIN (-ffast-math folds the NaN guard). M1 spec must
// pick one canonical float->int conversion. Known native failure.
import std.math

println(int(math.NAN))
println("edge_cast_float_nan_ok")
