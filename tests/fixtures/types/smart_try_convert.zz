// E2E: `try` across error types via explicit `convert_to_` impl.
struct MyErr { msg: str }
struct OtherErr { msg: str }

impl MyErr {
    func convert_to_OtherErr(self) -> OtherErr {
        OtherErr{msg: self.msg}
    }
}

func fetch() -> Result<int, MyErr> {
    .ok(7)
}

func load() -> Result<int, OtherErr> {
    x := try fetch()
    .ok(x * 6)
}

r := load()
match r {
    .ok(v) => println(v)
    .err(e) => println(e.msg)
}
println("smart_try_convert_ok")
