// E2E: prefix `try` sugar + `?` — same error type (identity conversion).
func fetch() -> Result<int, str> {
    .ok(42)
}

func load() -> Result<int, str> {
    // prefix form on a full postfix chain
    x := try fetch()
    y := fetch()?
    .ok(x + y)
}

func chain() -> Result<int, str> {
    // `try a() + c`: try binds only `a()`, `+ c` runs after unwrap
    v := try fetch() + 8
    .ok(v)
}

r := load()
match r {
    .ok(v) => println(v)
    .err(e) => println(e)
}
c := chain()
match c {
    .ok(v) => println(v)
    .err(e) => println(e)
}
println("smart_try_ok")
