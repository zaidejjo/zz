// E2E: Struct embedding (anonymous fields) — composition via promotion.
// `User` embeds `Base`: `u.id` resolves as `u.Base.id`, and `u.area()`
// dispatches to `Base.area` with the embedded value as receiver.
// Literals can be written flat (`User{id: 1, ...}`), explicit
// (`User{Base: Base{id: 1}, ...}`), or shorthand (`User{Base{id: 1}, ...}`).
struct Base {id: int, name: str}

struct User {Base, age: int}

impl Base {
    func area(self) -> int {
        self.id * 2
    }
    func who(self) -> str {
        "base"
    }
}

impl User {
    func who(self) -> str {
        "user"
    }
}

// Flat init: promoted fields nest into `Base` automatically.
zaid := User{id: 1, name: "Zaid Ajo", age: 19}
// Promoted field reads.
println("id={zaid.id}")
println("name={zaid.name}")
println("age={zaid.age}")
// Direct path still works.
println("direct={zaid.Base.name}")
// Promoted method call.
println("area={zaid.area()}")
// Outer method shadows the embedded one.
println("who={zaid.who()}")

// Promoted mutation writes through to the embedded struct.
zaid.id = 99
println("mut={zaid.id}")
println("mut_direct={zaid.Base.id}")
println("area2={zaid.area()}")

// Explicit nested init.
u2 := User{Base{id: 2, name: "Bo"}, age: 5}
println("u2id={u2.id}")
println("u2name={u2.name}")
println("u2area={u2.area()}")

// Shorthand init: `Base{...}` means `Base: Base{...}`.
u3 := User{Base{id: 3, name: "Cy"}, age: 6}
println("u3id={u3.id}")
println("u3area={u3.area()}")

// Transitive promotion through two levels.
struct Mid {Base, tag: int}

struct Outer {Mid, top: int}
o := Outer{Mid{id: 4, name: "Dee", tag: 7}, top: 8}
println("deep={o.id}")
println("deep_name={o.name}")
println("deep_area={o.area()}")
println("deep_tag={o.tag}")

// Whole-struct display matches the VM: `Type{field: value, ...}`.
println(zaid)
println("whole={u2}")

// Unboxed structs print through generated `debug_string` functions.
struct Pt {x: int, y: int}
pt := Pt{x: 1, y: 2}
println(pt)
println("pt={pt}")
println("pts={str(pt)}")

println("struct_embedding_ok")
