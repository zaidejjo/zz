// features: bool-logic, comparison, enums, func-call, match, pub-visibility
// Support module for enum_import.zz: cross-module `pub enum`.
pub enum Color {
    Red,
    Green,
    Blue,
    Custom(str),
}

pub func is_red(c: Color) -> bool {
    match c {
        .Red => true,
        _ => false,
    }
}
