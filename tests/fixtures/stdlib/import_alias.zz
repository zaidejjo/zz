// features: casts, float-arith, func-call, import-alias, imports, locals, print, selective-import, std-fs, std-math, std-process, std-str, string-literal
// E2E: selective/module import aliases resolve identically in VM and AOT.
// Bare (`sin`), aliased (`rts`), module-aliased (`f.exists`), and wildcard
// (`length`) calls must all lower to their canonical natives.
// The scratch path is per-process so parallel test runners (per-file
// parity tests + the discover sweep) never share it.
import std.math(sin)
import std.fs(read_to_string as rts)
import std.fs as f
import std.str(length)
import std.process(pid)

func main() {
    println(sin(0.0))
    p := "/tmp/zz_import_alias_{pid()}.txt"
    f.write(p, "alias-data")
    println(rts(p))
    println(f.exists(p))
    println(length("hello"))
    f.remove_file(p)
    println("import_alias_ok")
}
