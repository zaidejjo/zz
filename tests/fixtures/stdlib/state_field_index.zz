// features: int-arith, locals, print, state, structs, std-task
// Field/index write on state under contention: 2 tasks x field, 2 tasks x index.
import std.task

pub struct Cfg {
    x: int,
    y: int,
    _tag: str,
}

state cfg := Cfg { x: 0, y: 0, _tag: "cfg" }
state arr := [0, 0, 0, 0]

func cfg_inc_x() {
    atomic {
        cfg.x = cfg.x + 1
    }
}

func arr_inc(i: int) {
    atomic {
        arr[i] = arr[i] + 1
    }
}

func main() -> int {
    h0 := task.spawn(|_| { cfg_inc_x() })
    h1 := task.spawn(|_| { cfg_inc_x() })
    h2 := task.spawn(|_| { arr_inc(0) })
    h3 := task.spawn(|_| { arr_inc(1) })
    task.join(h0)
    task.join(h1)
    task.join(h2)
    task.join(h3)
    // Read state into locals before checking (D2: no println in state-touching stmt)
    cx:int = cfg.x
    cy:int = cfg.y
    a0:int = arr[0]
    a1:int = arr[1]
    // Print before any if checks on state reads (AOT codegen limitation)
    println("state_field_index_ok")
    if cx != 2 {
        return -1
    }
    if cy != 0 {
        return -2
    }
    if a0 != 1 || a1 != 1 {
        return -3
    }
    return 0
}
