// features: int-arith, locals, print, state, structs, std-task
// Field/index write on state under contention: 2 tasks x nested field,
// 2 tasks x index. The checks are real (Result errors fail the run).
import std.task

pub struct Inner {
    v: int,
}

pub struct Cfg {
    x: int,
    y: int,
    inner: Inner,
    _tag: str,
}

state cfg := Cfg { x: 0, y: 0, inner: Inner { v: 0 }, _tag: "cfg" }
state arr := [0, 0, 0, 0]

func cfg_inc() {
    atomic {
        cfg.x = cfg.x + 1
        cfg.inner.v = cfg.inner.v + 1
    }
}

func arr_inc(i: int) {
    atomic {
        arr[i] = arr[i] + 1
    }
}

func main() -> Result<int, str> {
    h0 := task.spawn(|_| { cfg_inc() })
    h1 := task.spawn(|_| { cfg_inc() })
    h2 := task.spawn(|_| { arr_inc(0) })
    h3 := task.spawn(|_| { arr_inc(1) })
    task.join(h0)
    task.join(h1)
    task.join(h2)
    task.join(h3)
    // Read state into locals before checking (D2: no println in a
    // state-touching statement). The prints make value drift visible.
    cx:int = cfg.x
    cy:int = cfg.y
    iv:int = cfg.inner.v
    tag:str = cfg._tag
    a0:int = arr[0]
    a1:int = arr[1]
    println(cx)
    println(cy)
    println(iv)
    println(tag)
    println(a0)
    println(a1)
    if cx != 2 {
        return .err("cfg.x")
    }
    if cy != 0 {
        return .err("cfg.y")
    }
    if iv != 2 {
        return .err("cfg.inner.v")
    }
    if tag != "cfg" {
        return .err("cfg._tag")
    }
    if a0 != 1 || a1 != 1 {
        return .err("arr")
    }
    println("state_field_index_ok")
    return .ok(0)
}
