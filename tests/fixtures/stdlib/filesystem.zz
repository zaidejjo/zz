// E2E: std.fs — filesystem operations
import std.fs

// write + read
match fs.write_file("/tmp/zz_e2e_test.txt", "hello from zz") {
    .ok(_)  => println("write_ok"),
    .err(e) => println("write_err: {e}"),
}

match fs.read_file("/tmp/zz_e2e_test.txt") {
    .ok(content) => println(content),
    .err(e)      => println("read_err: {e}"),
}

// exists
println(fs.exists("/tmp/zz_e2e_test.txt"))
println(fs.exists("/tmp/zz_no_such_file.txt"))

// cleanup
fs.write_file("/tmp/zz_e2e_test.txt", "")

println("fs_ok")
