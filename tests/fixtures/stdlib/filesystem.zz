// features: comparison, elvis, imports, locals, match, option-result, print, selective-import, std-env, std-fs, std-process, string-literal
// E2E: std.fs — filesystem operations.
// Scratch path is per (process, sweep task) so parallel runners never
// share it.
import std.env
import std.fs
import std.process(pid)

scratch_tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
scratch := "{env.temp_dir()}/zz_e2e_test_{pid()}_{scratch_tok}.txt"

// write + read
match fs.write(scratch, "hello from zz") {
    .ok(_) => println("write_ok")
    .err(e) => println("write_err: {e}")
}

match fs.read(scratch) {
    .ok(content) => println(content)
    .err(e) => println("read_err: {e}")
}

// exists
println(fs.exists(scratch))
println(fs.exists("{env.temp_dir()}/zz_no_such_file.txt"))

// cleanup
_u1 := fs.write(scratch, "")

println("fs_ok")
