// E2E: std.fs — filesystem operations.
// Scratch path is per (process, sweep task) so parallel runners never
// share it.
import std.env
import std.fs
import std.process(pid)

scratch_tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
scratch := "/tmp/zz_e2e_test_{pid()}_{scratch_tok}.txt"

// write + read
match fs.write_file(scratch, "hello from zz") {
    .ok(_) => println("write_ok")
    .err(e) => println("write_err: {e}")
}

match fs.read_file(scratch) {
    .ok(content) => println(content)
    .err(e) => println("read_err: {e}")
}

// exists
println(fs.exists(scratch))
println(fs.exists("/tmp/zz_no_such_file.txt"))

// cleanup
fs.write_file(scratch, "")

println("fs_ok")
