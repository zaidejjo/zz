import std.sqlz

struct User { id: int, name: str }

// ── Basic transaction: COMMIT on clean return ──────────────────────
db := sqlz.open(":memory:")
db.exec("""CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)""")

match sqlz.transaction(db, |tx| {
    tx.exec("""INSERT INTO users VALUES (1, 'alice')""")
    tx.exec("""INSERT INTO users VALUES (2, 'bob')""")
    "ok"
}) {
    .ok(v)  => println("commit_ok:{v}")
    .err(e) => println("FAIL commit: {e}")
}

users: [User] = db.query("""SELECT id, name FROM users ORDER BY id""")
print(users[0].name)
print(users[1].name)

// ── Rollback on closure error ──────────────────────────────────────
// Alice row still exists; inserting a duplicate key should fail.
match sqlz.transaction(db, |tx| {
    tx.exec("""INSERT INTO users VALUES (1, 'duplicate')""")
    "should_not_reach"
}) {
    .ok(_)  => println("FAIL: error not caught")
    .err(_) => println("rollback_ok")
}

// Original rows untouched after rollback.
users2: [User] = db.query("""SELECT id, name FROM users ORDER BY id""")
print(users2[0].name)
print(len(users2))

// ── Return value from closure propagates as .ok(value) ─────────────
match sqlz.transaction(db, |tx| {
    tx.exec("""INSERT INTO users VALUES (3, 'carol')""")
    3
}) {
    .ok(v)  => println("return_ok:{v}")
    .err(e) => println("FAIL return: {e}")
}

// ── db.transaction alias works identically ─────────────────────────
match db.transaction(|tx| {
    tx.exec("""INSERT INTO users VALUES (4, 'dave')""")
    "alias"
}) {
    .ok(v)  => println("alias_tx:{v}")
    .err(e) => println("FAIL alias: {e}")
}

print("sqlz_tx_ok")
