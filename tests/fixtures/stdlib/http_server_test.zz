// tests/fixtures/stdlib/http_server_test.zz — HTTP server routes
import std.http

func main() -> Result<int, str> {
    // Create a server and chain routes
    s := http.server()
    s = s.route("GET", "/greet", |_req| "hello!")
    s = s.route("POST", "/data", |req| "got: {req.body}")
    s = s.route("PUT", "/items", |_req| "item updated")
    s = s.route("DELETE", "/items", |_req| "item deleted")

    // Dispatch requests
    r1 := http.test(s, "GET", "/greet", "")
    println("r1: {r1.text()}")
    r2 := http.test(s, "POST", "/data", "test-payload")
    println("r2: {r2.text()}")
    r3 := http.test(s, "PUT", "/items", "new-item")
    println("r3: {r3.text()}")
    r4 := http.test(s, "DELETE", "/items", "")
    println("r4: {r4.text()}")

    // Test wildcard route
    s = s.route("GET", "*", |_req| "fallback")
    r5 := http.test(s, "GET", "/anything", "")
    println("r5 (wildcard): {r5.text()}")

    println("http_server_test_ok")
    .ok(0)
}
