// E2E: std.fs — read_to_string, write, exists, remove_file
import std.fs

// write
match fs.write("/tmp/zz_phase4a_test.txt", "hello phase4a") {
    .ok(_)  => println("write_ok"),
    .err(e) => println("write_err: {e}"),
}

// read_to_string
match fs.read_to_string("/tmp/zz_phase4a_test.txt") {
    .ok(content) => println("read_ok: {content}"),
    .err(e)      => println("read_err: {e}"),
}

// exists
println(fs.exists("/tmp/zz_phase4a_test.txt"))
println(fs.exists("/tmp/zz_phase4a_nonexist.txt"))

// remove_file
match fs.remove_file("/tmp/zz_phase4a_test.txt") {
    .ok(_)  => println("remove_ok"),
    .err(e) => println("remove_err: {e}"),
}

// verify removed
println(fs.exists("/tmp/zz_phase4a_test.txt"))

println("fs_test_ok")
