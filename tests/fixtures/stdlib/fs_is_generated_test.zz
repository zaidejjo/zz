// features: arrays, comparison, imports, locals, match, option-result, print, std-env, std-fs, std-process, std-str, string-literal
// E2E: fs.is_generated — whole-file generated-content heuristic, one crossing.
import std.env
import std.fs
import std.process
import std.str

tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
base := "/tmp/zz_is_generated_{process.pid()}_{tok}"
marks := ["generated by", "auto-generated", "do not edit", "do not modify", "@generated", "generated code"]

func check(path: str, want: bool) {
    match fs.is_generated(path, marks) {
        .ok(g) => println("gen={g} want={want} same={g == want}")
        .err(_) => println("gen_bad")
    }
}

func write_ok(path: str, content: str) {
    match fs.write(path, content) {
        .ok(_) => noop()
        .err(e) => println("write_err: {e}")
    }
}

func noop() {
    
}

code := base + "_code.rs"
write_ok(code, "// hi\nfn f() {}\n")
check(code, false)

proto := base + "_proto.rs"
write_ok(proto, "// Code generated by protoc. DO NOT EDIT.\npackage foo\n")
check(proto, true)

auto := base + "_auto.py"
write_ok(auto, "# auto-generated file\nx = 1\n")
check(auto, true)

edit := base + "_edit.js"
write_ok(edit, "// DO NOT EDIT below\nvar x = 1;\n")
check(edit, true)

modi := base + "_modi.py"
write_ok(modi, "# do not modify\nx = 1\n")
check(modi, true)

atgen := base + "_atgen.ts"
write_ok(atgen, "// @generated\nconst x = 1;\n")
check(atgen, true)

gcode := base + "_gcode.c"
write_ok(gcode, "/* generated code */\nint x;\n")
check(gcode, true)

// Minified tiny file: single 2001-char line trips the gate.
big := ""
for _i in 0..2001 {
    big = big + "x"
}
mini := base + "_mini.js"
write_ok(mini, big + "\n")
check(mini, true)

// Exact-2000 boundary stays quiet.
exact := ""
for _i in 0..2000 {
    exact = exact + "x"
}
edge := base + "_edge.js"
write_ok(edge, exact + "\n")
check(edge, false)

// Four lines escape the tiny gate even with a huge line.
four := "aaa\n" + big + "\nb\nc\n"
fourp := base + "_four.js"
write_ok(fourp, four)
check(fourp, false)

// Longest counts chars, not bytes: 1100 multibyte chars (2200 bytes)
// stay under the gate.
wide := ""
for _i in 0..1100 {
    wide = wide + "é"
}
widep := base + "_wide.js"
write_ok(widep, wide + "\n")
check(widep, false)

// Non-ASCII lookalikes never complete an ASCII marker (İ unfolds with
// a combining dot, ﬁ/ß unfold away from marker bytes).
trick := base + "_trick.js"
write_ok(trick, "// do not modİfy ﬁ ß\nvar x = 1;\n")
check(trick, false)

// Empty, NUL, and invalid UTF-8 all report false (never generated;
// callers check those conditions via scan_counts first).
empty := base + "_empty.txt"
write_ok(empty, "")
check(empty, false)
bin := base + "_bin.dat"
write_ok(bin, "ab\x00cd\nef\n")
check(bin, false)
raw := base + "_raw.bin"
match process.run("sh", ["-c", "printf '\\377\\376\\n' > {raw}"]) {
    .ok(_) => noop()
    .err(_) => println("printf_bad")
}
check(raw, false)

// Missing files and directories are .err (io_error for dirs).
match fs.is_generated(base + "_missing.zz", marks) {
    .ok(_) => println("missing_bad")
    .err(_) => println("missing_err_ok")
}
match fs.is_generated("/tmp", marks) {
    .ok(_) => println("dir_bad")
    .err(e) => {
        dir_io := str.contains(e, "io_error")
        println("dir_err_ok: {dir_io}")
    }
}

// Size-0 procfs streams content without any writer rendezvous: the
// grow-to-EOF path with zero hang risk (skips cleanly off-Linux).
match fs.is_generated("/proc/version", marks) {
    .ok(g) => println("proc={g}")
    .err(_) => println("proc_skip")
}

println("fs_is_generated_ok")
