// E2E: spawn — parallel execution across cores
import std.io
import std.task
import std.chan

results := std.chan()
task.spawn(|_| {
    std.chan.send(results, 1 + 1)
})
task.spawn(|_| {
    std.chan.send(results, 2 * 3)
})
a:int = std.chan.recv(results)
b:int = std.chan.recv(results)
// Recv order follows thread scheduling — print min/max so VM/AOT match.
if a < b { io.println("{a} {b}") } else { io.println("{b} {a}") }
io.println("spawn_ok")
