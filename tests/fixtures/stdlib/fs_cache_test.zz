// features: arrays, comparison, imports, locals, match, option-result, print, std-env, std-fs, std-process, std-str, string-literal
// E2E: fs content cache — repeated reads return fresh data and share
// buffers; stat validation observes writes made outside std.fs; every
// std.fs mutator invalidates eagerly. Runs byte-identically on VM + AOT.
import std.env
import std.fs
import std.process
import std.str

func read_ok(p: str) -> str {
    return match fs.read(p) {
        .ok(s) => s
        .err(e) => "ERR:{e}"
    }
}

func main() {
    tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
    base := "/tmp/zz_fs_cache_{process.pid()}_{tok}"
    path := base + "/a.txt"
    _ := fs.remove_dir_all(base)
    match fs.mkdir_all(base) {
        .ok(_) => println("mkdir_ok")
        .err(e) => println("mkdir_err: {e}")
    }
    // First read populates, second read is a cache hit (same bytes).
    match fs.write(path, "one") {
        .ok(_) => println("write_ok")
        .err(e) => println("write_err: {e}")
    }
    a := read_ok(path)
    b := read_ok(path)
    println("repeat: {a == b} {a}")
    // `fs.write` invalidates: a same-length rewrite must be observed.
    match fs.write(path, "two") {
        .ok(_) => println("rewrite_ok")
        .err(e) => println("rewrite_err: {e}")
    }
    println("rewritten: {read_ok(path)}")
    // Append invalidates too.
    match fs.append(path, "!") {
        .ok(_) => println("append_ok")
        .err(e) => println("append_err: {e}")
    }
    println("appended: {read_ok(path)}")
    // `read_bytes` shares the cached buffer (length is the observable part).
    match fs.read_bytes(path) {
        .ok(bytes) => println("bytes: {len(bytes)}")
        .err(e) => println("bytes_err: {e}")
    }
    // A write from another process has a new stat fingerprint: the next
    // read must not serve the old cache line.
    sh_body := "printf 'outside' > {path}"
    match process.run("sh", ["-c", sh_body]) {
        .ok(_) => println("outside_ok")
        .err(_) => println("outside_bad")
    }
    println("outside: {read_ok(path)}")
    // scan_counts + is_generated reuse one cached read; repeated calls keep
    // the same answers.
    gen := base + "/gen.rs"
    match fs.write(gen, "// Code generated by protoc. DO NOT EDIT.\nfn f() {}\n") {
        .ok(_) => println("gen_write_ok")
        .err(e) => println("gen_write_err: {e}")
    }
    marks := ["generated by", "do not edit"]
    match fs.scan_counts(gen, ["//"], "", "", false, false) {
        .ok(r) => println("scan: {r[0]},{r[1]},{r[2]},{r[3]},{r[4]}")
        .err(e) => println("scan_err: {e}")
    }
    match fs.is_generated(gen, marks) {
        .ok(g) => println("gen1: {g}")
        .err(e) => println("gen_err: {e}")
    }
    match fs.is_generated(gen, marks) {
        .ok(g) => println("gen2: {g}")
        .err(e) => println("gen_err: {e}")
    }
    // Rewriting via std.fs must invalidate the generated probe too.
    match fs.write(gen, "fn f() {}\n") {
        .ok(_) => println("gen_rewrite_ok")
        .err(e) => println("gen_rewrite_err: {e}")
    }
    match fs.scan_counts(gen, ["//"], "", "", false, false) {
        .ok(_) => println("scan2_ok")
        .err(e) => println("scan2_err: {e}")
    }
    match fs.is_generated(gen, marks) {
        .ok(g) => println("gen3: {g}")
        .err(e) => println("gen_err: {e}")
    }
    // Invalid UTF-8 is a stable read error (negative-cached after the first
    // probe); reading it again must stay an error, not panic.
    raw := base + "/raw.bin"
    sh_raw := "printf '\\377\\376\\n' > {raw}"
    match process.run("sh", ["-c", sh_raw]) {
        .ok(_) => println("raw_ok")
        .err(_) => println("raw_bad")
    }
    r1 := read_ok(raw)
    r2 := read_ok(raw)
    pinned := str.contains(r1, "invalid_input")
    println("invalid_utf8: {pinned} {r1 == r2}")
    // Recursive removal invalidates the whole subtree.
    match fs.mkdir_all(base + "/sub") {
        .ok(_) => println("sub_ok")
        .err(e) => println("sub_err: {e}")
    }
    match fs.write(base + "/sub/deep.txt", "deep") {
        .ok(_) => println("deep_ok")
        .err(e) => println("deep_err: {e}")
    }
    _ := read_ok(base + "/sub/deep.txt")
    match fs.remove_dir_all(base + "/sub") {
        .ok(_) => println("rm_ok")
        .err(e) => println("rm_err: {e}")
    }
    gone := read_ok(base + "/sub/deep.txt")
    was_gone := str.contains(gone, "not_found")
    println("removed: {was_gone}")
    _ := fs.remove_dir_all(base)
}
