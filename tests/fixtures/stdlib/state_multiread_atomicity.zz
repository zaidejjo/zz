// Step 3b.1 fixture: multi-state read atomicity under lock.
// features: int-arith, locals, print, state, std-task, std-str, short-circuit
import std.task
import std.str

state a := 100
state b := 0

func busy() {
    acc := 0
    for i in 0..50 {
        acc = (acc + i * 7) % 1009
    }
    if acc < 0 { println("unreachable") }
}

func writer_fwd() {
    n := 0
    while n < 5000 {
        atomic {
            a -= 1
            busy()
            b += 1
        }
        n += 1
    }
}

func writer_back() {
    n := 0
    while n < 5000 {
        atomic {
            b -= 1
            busy()
            a += 1
        }
        n += 1
    }
}

func parse_sum(s: str) -> int {
    bytes := std.str.bytes(s)
    total := 0
    cur := 0
    sign := 1
    started := 0
    seen := 0
    for j in 0..len(bytes) {
        c := bytes[j]
        if c == 45 { sign = 0 - 1 }
        else if c >= 48 && c <= 57 {
            cur = cur * 10 + (c - 48)
            started = 1
        } else {
            if started == 1 { total += sign * cur; cur = 0; sign = 1; seen += 1; started = 0 }
        }
    }
    if started == 1 { total += sign * cur; seen += 1 }
    if seen != 2 { return 0 - 1 }
    return total
}

func check(ax: int, bx: int) -> int {
    if ax + bx != 100 { return 1 }
    return 0
}

func v1(m: int) -> int {
    v := 0
    for i in 0..m {
        x := a + b
        if x != 100 { v += 1 }
    }
    return v
}

func v2(m: int) -> int {
    v := 0
    for i in 0..m {
        pair := [a, b]
        if pair[0] + pair[1] != 100 { v += 1 }
    }
    return v
}

func v3(m: int) -> int {
    v := 0
    for i in 0..m {
        s := Pair { x: a, y: b }
        if s.x + s.y != 100 { v += 1 }
    }
    return v
}

func v4(m: int) -> int {
    v := 0
    for i in 0..m {
        s := "{a} {b}"
        if parse_sum(s) != 100 { v += 1 }
    }
    return v
}

func v5(m: int) -> int {
    v := 0
    for i in 0..m {
        v = v + check(a, b)
    }
    return v
}

func v6(m: int) -> int {
    v := 0
    for i in 0..m {
        if a > 0 && b >= 0 {
            x := a + b
            if x != 100 { v += 1 }
        }
    }
    return v
}

func main() -> Result<int, str> {
    m := 3000
    h0 := task.spawn(|_| { writer_fwd() })
    h1 := task.spawn(|_| { writer_back() })
    c1 := task.spawn(|_| { v1(m) })
    c2 := task.spawn(|_| { v2(m) })
    c3 := task.spawn(|_| { v3(m) })
    c4 := task.spawn(|_| { v4(m) })
    c5 := task.spawn(|_| { v5(m) })
    c6 := task.spawn(|_| { v6(m) })
    n1: int = task.join(c1)
    n2: int = task.join(c2)
    n3: int = task.join(c3)
    n4: int = task.join(c4)
    n5: int = task.join(c5)
    n6: int = task.join(c6)

    task.join(h0)
    task.join(h1)

    println("V1={n1} V2={n2} V3={n3} V4={n4} V5={n5} V6={n6}")
    return .ok(0)
}

struct Pair { x: int, y: int }
