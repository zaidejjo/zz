// features: imports, match, option-result, print, std-net, std-time, string-literal
// tests/fixtures/stdlib/net_tls_listener_shutdown.zz — TLS listener shutdown C twin.
// Create a TLS listener, shut it down, verify .ok(true) on VM and AOT.
// No client connects; just register + shutdown.
import std.net

func main() -> Result<int, str> {
    cert := "tests/fixtures/stdlib/data/net_tls/cert.pem"
    key := "tests/fixtures/stdlib/data/net_tls/key.pem"

    l := net.tls_listen("127.0.0.1:0", cert, key)
    match l {
        .ok(h) => {
            println("tls_listen_ok")
            r := net.tls_listener_close(h)
            match r {
                .ok(v) => {
                    println("tls_listener_shutdown_ok: {v}")
                }
                .err(e) => {
                    println("tls_listener_shutdown_err: {e}")
                }
            }
        }
        .err(e) => {
            println("tls_listen_err: {e}")
        }
    }

    println("net_tls_listener_shutdown_ok")
    return .ok(0)
}
