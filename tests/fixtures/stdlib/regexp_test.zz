// E2E: std.regexp — compile, match, find, replace, captures, email
import std.regexp

// NOTE: all bindings stay at top level. Declaring locals inside a second
// (or later) `if let` block mis-resolves them in the VM (pre-existing
// scope bug, unrelated to regexp) — see feature/std-regexp notes.

hello := "hello"
upper := "HELLO"
digpat := "\\d+"
mixed := "abc123"
phonepat := "(\\d+)-(\\d+)"
call := "call 555-1234 now"
nodigits := "no digits here"
dot := "$1.$2"
badpat := "([a-z"
goodmail := "user@example.com"
badmail := "not-an-email"
nonestr := "none"

// ── Regexp.new + is_match (method syntax) ──
w := Regexp.new("[a-z]+")
match w {
    .ok(word) => println("lower_match: {word.is_match(hello)}"),
    .err(_) => println("compile_bad"),
}
match w {
    .ok(word) => println("lower_reject: {word.is_match(upper)}"),
    .err(_) => println("compile_bad"),
}

// ── free-function form ──
d := regexp.compile(digpat)
match d {
    .ok(digits) => println("free_match: {regexp.is_match(digits, mixed)}"),
    .err(_) => println("compile_bad"),
}

// ── find / replace / captures ──
p := Regexp.new(phonepat)
match p {
    .ok(ph) => println("found: {ph.find(call) ?? nonestr}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("nofind: {ph.find(nodigits) ?? nonestr}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("repl: {ph.replace_all(call, dot)}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("caps_len: {len(ph.captures(call))}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("cap0: {ph.captures(call)[0]}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("cap1: {ph.captures(call)[1]}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("cap2: {ph.captures(call)[2]}"),
    .err(_) => println("compile_bad"),
}
match p {
    .ok(ph) => println("nocaps_len: {len(ph.captures(nodigits))}"),
    .err(_) => println("compile_bad"),
}

// ── invalid pattern surfaces .err ──
match Regexp.new(badpat) {
    .ok(_) => println("invalid_bad"),
    .err(_) => println("invalid_ok"),
}

// ── email validation helper ──
println("email_ok: {regexp.is_email(goodmail)}")
println("email_bad: {regexp.is_email(badmail)}")

println("regexp_ok")
