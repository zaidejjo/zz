func main() -> Result<int, str> {
    for run in 0..5 {
        log = []
        h0 := task.spawn(|_| { push1000() })
        h1 := task.spawn(|_| { push1000() })
        h2 := task.spawn(|_| { push1000() })
        h3 := task.spawn(|_| { push1000() })
        task.join(h0)
        task.join(h1)
        task.join(h2)
        task.join(h3)
        if vec.len(log) != 4000 {
            return .err("composite_len_mismatch")
        }
    }
    println("composite_ok")
    return .ok(0)
}
