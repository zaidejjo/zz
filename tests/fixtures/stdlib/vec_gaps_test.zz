// features: arrays, comparison, float-arith, imports, option-result, print, std-vec, string-literal
// E2E: std.vec pure-ZZ gap functions (fold/sum/product/min_val/max_val/sum_f/product_f/concat/flatten/index_of/last_index_of + vec.* aliases).
import std.vec

func main() {
    // ── Int aggregation ──
    println("fold([1,2,3,4], 0): {vec.fold([1, 2, 3, 4], 0)}")
    println("sum([1,2,3,4]): {vec.sum([1, 2, 3, 4])}")
    println("product([1,2,3,4]): {vec.product([1, 2, 3, 4])}")
    // ── Generic min/max (Option) ──
    match vec.min_val([3, 1, 2]) {
        .some(v) => println("min_val([3,1,2]): {v}")
        .none => println("min_val([3,1,2]): none")
    }
    match vec.max_val([3, 1, 2]) {
        .some(v) => println("max_val([3,1,2]): {v}")
        .none => println("max_val([3,1,2]): none")
    }
    empty := []
    match vec.min_val(empty) {
        .some(_) => println("min_val([]): unexpected some")
        .none => println("min_val([]): none")
    }
    // ── Float aggregation ──
    println("sum_f([1.5, 2.5, 3.0]): {vec.sum_f([1.5, 2.5, 3.0])}")
    println("product_f([1.5, 2.0]): {vec.product_f([1.5, 2.0])}")
    // ── Structural transforms ──
    r := vec.concat([1, 2], [3, 4])
    println("concat([1,2],[3,4]): {r}")
    f := vec.flatten([[1, 2], [3], [4, 5]])
    println("flatten([[1,2],[3],[4,5]]): {f}")
    // ── Index helpers ──
    println("index_of([1,2,3,2], 2): {vec.index_of([1, 2, 3, 2], 2)}")
    println("index_of([1,2,3], 9): {vec.index_of([1, 2, 3], 9)}")
    println("last_index_of([1,2,3,2], 2): {vec.last_index_of([1, 2, 3, 2], 2)}")
    println("last_index_of([1,2,3], 9): {vec.last_index_of([1, 2, 3], 9)}")
    println("vec_gaps_ok")
}
