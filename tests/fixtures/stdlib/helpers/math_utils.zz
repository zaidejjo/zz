// features: comparison, func-call, int-arith, locals, pub-visibility, return
// Helper module for selective import tests.
pub func double(x: int) -> int {
    return x * 2
}

pub func triple(x: int) -> int {
    return x * 3
}

pub func squared<T: Num>(number: T) {
    return number**2
}

pub PI := 314
