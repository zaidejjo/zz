// E2E: std.fs path lexing — normalize/join/basename/dirname/is_absolute/
// extension. Host-style assertions (unix here; windows shapes are pinned
// by `natives::fs::path` unit tests and mirror C in `core.c`).
import std.fs

func main() {
    println(fs.normalize("/a//b/./c/../d"))
    println(fs.normalize("a/b/../../c"))
    println(fs.normalize("/../.."))
    println(fs.normalize(""))
    println(fs.normalize("a\\b\\c"))
    println(fs.join("/a/b", "c/d"))
    println(fs.join("/a/b", "/c"))
    println(fs.join("/a", "../x"))
    println(fs.basename("/a/b/c.txt"))
    println(fs.basename("/a/b/"))
    println(fs.dirname("/a/b/c.txt"))
    println(fs.dirname("c.txt"))
    println(fs.is_absolute("/a"))
    println(fs.is_absolute("a/b"))
    println(fs.extension("archive.tar.gz"))
    println(fs.extension(".gitignore"))
    println(fs.extension("README"))
    println("fs_path_ok")
}
