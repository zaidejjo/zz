// features: int-arith, locals, print, state, std-dict
// D2: dict index-store on a state dict compiles without `atomic { }`.
// Dicts use index syntax (`d["k"] = v`) — there are no `dict.set`/`dict.insert`/
// `dict.remove` natives; the index store is the "dict.set" equivalent.
state cfg := {}

func main() -> int {
    cfg["mode"] = "fast"
    if cfg["mode"] != "fast" { return -1 }
    println("state_d2_dict_set_ok")
    return 0
}
