// E2E: variable loop bound — `0..n` trips exactly n times.
import std.task
import std.chan

func main() {
    n := 5000
    c := std.chan()
    h := task.spawn(|_| {
        total := 0
        for i in 0..n {
            v := 0
            v = std.chan.recv(c)
            total = total + v
        }
        total
    })
    for i in 0..5000 {
        std.chan.send(c, 1)
    }
    r: int = task.join(h)
    println("vartrip:{r}")
    println("vartrip_ok")
}
