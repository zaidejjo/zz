// E2E: recall — calling the same spawn-bearing function twice must give
// each call its own captures. Regression: a parent-shape cache keyed on
// allocation addresses served a stale frozen parent when the second
// call's frame reused the first call's freed address, sending workers
// into the previous call's channel (deadlock). Deterministic: exact sums.
import std.task
import std.chan

func fan(n: int) -> int {
    c := std.chan()
    for i in 0..n {
        task.spawn(|_| {
            std.chan.send(c, i)
        })
    }
    sum := 0
    for i in 0..n {
        v := 0
        v = std.chan.recv(c)
        sum = sum + v
    }
    sum
}

func main() {
    a := fan(100)
    b := fan(1000)
    println("{a}")
    println("{b}")
    if a == 4950 {
        if b == 499500 {
            println("recall_ok")
        }
    }
}
