// E2E: std.crypto passwords — argon2 + bcrypt roundtrips
import std.crypto

pw := "correct horse"
wrong := "wrong horse"
junk := "not-a-hash"

// ── Argon2id ──
ah := crypto.argon2_hash(pw)
println("argon2_ok: {crypto.argon2_verify(ah, pw)}")
println("argon2_wrong: {crypto.argon2_verify(ah, wrong)}")
println("argon2_junk: {crypto.argon2_verify(junk, pw)}")
println("argon2_salt: {ah == crypto.argon2_hash(pw)}")

// ── Bcrypt ──
bh := crypto.bcrypt_hash(pw)
println("bcrypt_ok: {crypto.bcrypt_verify(bh, pw)}")
println("bcrypt_wrong: {crypto.bcrypt_verify(bh, wrong)}")
println("bcrypt_junk: {crypto.bcrypt_verify(junk, pw)}")
println("bcrypt_salt: {bh == crypto.bcrypt_hash(pw)}")

// ── std-qualified spelling ──
println("std_spell: {std.crypto.bcrypt_verify(bh, pw)}")

println("crypto_passwords_ok")
