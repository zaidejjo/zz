// E2E: std.crypto core — sha256, sha512, hmac, random_bytes, ct_eq
import std.crypto

// NOTE: expected digests live in bindings — string literals inside
// `{...}` interpolation do not support escapes.
abc := "abc"
empty := ""
sha256_abc := "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
sha256_empty := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
sha512_abc := "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
hmac_rfc := "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
key := "Jefe"
msg := "what do ya want for nothing?"
abd := "abd"
ab := "ab"

// ── SHA-256 known answers ──
println("sha256_abc: {crypto.sha256(abc) == sha256_abc}")
println("sha256_empty: {crypto.sha256(empty) == sha256_empty}")

// ── SHA-512 known answer ──
println("sha512_abc: {crypto.sha512(abc) == sha512_abc}")

// ── HMAC-SHA-256 (RFC 4231 case 2) ──
println("hmac: {crypto.hmac_sha256(key, msg) == hmac_rfc}")

// ── CSPRNG: shape + uniqueness ──
r1 := crypto.random_bytes(16)
r2 := crypto.random_bytes(16)
println("rand_len: {r1.length() == 32}")
println("rand_diff: {r1 == r2}")
println("rand_zero: {crypto.random_bytes(0) == empty}")

// ── constant-time equality ──
println("ct_same: {crypto.ct_eq(abc, abc)}")
println("ct_diff: {crypto.ct_eq(abc, abd)}")
println("ct_len: {crypto.ct_eq(abc, ab)}")
println("ct_empty: {crypto.ct_eq(empty, empty)}")

// ── std-qualified spelling ──
println("std_spell: {std.crypto.sha256(abc) == crypto.sha256(abc)}")

println("crypto_ok")
