// features: imports, int-arith, locals, print, state, std-task, atomic
// Regression: `return` inside `atomic { }` must release the state lock so a
// state read after the task joins doesn't deadlock in AOT (ZZ native).
// VM passes instantly; before the fix AOT hung (>420s, no output).
import std.task

state next_id := 1000

func new_id() -> int {
    atomic {
        id := next_id
        next_id = next_id + 1
        return id
    }
}

func main() -> int {
    h0 := task.spawn(|_| { new_id() })
    h1 := task.spawn(|_| { new_id() })
    task.join(h0)
    task.join(h1)
    println("next_id={next_id}")
    return 0
}
