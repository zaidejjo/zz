// E2E: `fs.FS` providers (Os / Mem / Tar / Embed) + binary-safe
// `read_chunk_bytes`. Same output on VM and AOT.
import std.fs

func main() {
    // memfs: write/read/append/predicates/listing.
    match fs.memfs() {
        .ok(m) => {
            match fs.write_at(m, "a/b.txt", "hello") {
                .ok(_) => println("mem_write_ok")
                .err(e) => println("mem_write_err: {e}")
            }
            match fs.append_at(m, "a/b.txt", " world") {
                .ok(_) => println("mem_append_ok")
                .err(e) => println("mem_append_err: {e}")
            }
            match fs.read_to_string_at(m, "a/./b.txt") {
                .ok(c) => println("mem_content: {c}")
                .err(e) => println("mem_read_err: {e}")
            }
            println(fs.exists_at(m, "a/b.txt"))
            println(fs.exists_at(m, "a/missing.txt"))
            println(fs.is_file_at(m, "a/b.txt"))
            println(fs.is_dir_at(m, "a"))
            match fs.read_dir_at(m, "a") {
                .ok(entries) => println("mem_readdir: {entries}")
                .err(e) => println("mem_readdir_err: {e}")
            }
            match fs.remove_file_at(m, "a/b.txt") {
                .ok(_) => println("mem_remove_ok")
                .err(e) => println("mem_remove_err: {e}")
            }
            println(fs.exists_at(m, "a/b.txt"))
            match fs.read_to_string_at(m, "a/b.txt") {
                .ok(_) => println("unexpected_ok")
                .err(e) => println("mem_notfound: {e}")
            }
        }
        .err(e) => println("memfs_err: {e}")
    }

    // osfs: same calls, real disk.
    match fs.osfs() {
        .ok(o) => {
            match fs.write_at(o, "/tmp/zz_vfs_os.txt", "os-data") {
                .ok(_) => println("os_write_ok")
                .err(e) => println("os_write_err: {e}")
            }
            match fs.read_to_string_at(o, "/tmp/zz_vfs_os.txt") {
                .ok(c) => println("os_content: {c}")
                .err(e) => println("os_read_err: {e}")
            }
            println(fs.exists_at(o, "/tmp/zz_vfs_os.txt"))
            match fs.remove_file_at(o, "/tmp/zz_vfs_os.txt") {
                .ok(_) => println("os_remove_ok")
                .err(e) => println("os_remove_err: {e}")
            }
        }
        .err(e) => println("osfs_err: {e}")
    }

    // tarfs: read-only view over the checked-in sample archive.
    match fs.tarfs("tests/fixtures/stdlib/data/sample.tar") {
        .ok(t) => {
            match fs.read_to_string_at(t, "docs/hi.txt") {
                .ok(c) => println("tar_content: {c}")
                .err(e) => println("tar_read_err: {e}")
            }
            match fs.read_dir_at(t, "docs") {
                .ok(entries) => println("tar_readdir: {entries}")
                .err(e) => println("tar_readdir_err: {e}")
            }
            println(fs.is_dir_at(t, "docs"))
            match fs.write_at(t, "docs/new.txt", "x") {
                .ok(_) => println("unexpected_tar_write_ok")
                .err(e) => println("tar_readonly: {e}")
            }
            match fs.tarfs("tests/fixtures/stdlib/data/missing.tar") {
                .ok(_) => println("unexpected_tar_ok")
                .err(e) => println("tar_missing: {e}")
            }
        }
        .err(e) => println("tarfs_err: {e}")
    }

    // embedfs without `--embed`: empty but total.
    match fs.embedfs() {
        .ok(e2) => {
            println(fs.exists_at(e2, "anything.txt"))
            match fs.read_to_string_at(e2, "anything.txt") {
                .ok(_) => println("unexpected_embed_ok")
                .err(e) => println("embed_empty: {e}")
            }
        }
        .err(e) => println("embedfs_err: {e}")
    }

    // read_chunk_bytes: binary-safe streaming (byte-exact on archives).
    match File.open("tests/fixtures/stdlib/data/sample.tar", "r") {
        .ok(f) => {
            match fs.read_chunk_bytes(f, 5) {
                .ok(b) => println("chunk5: {b[0]},{b[1]},{b[2]},{b[3]},{b[4]}")
                .err(e) => println("chunk_err: {e}")
            }
            fs.close(f)
            0
        }
        .err(e) => {
            println("open_err: {e}")
            0
        }
    }

    println("fs_vfs_ok")
}
