// E2E: relay cascade — 10 tasks chained by channels, each hop +1.
// Exercises handoff chaining past any inline nesting budget.
import std.task
import std.chan

func main() {
    cur := std.chan()
    first := cur
    for i in 0..10 {
        prev := cur
        nxt := std.chan()
        task.spawn(|_| {
            v := 0
            v = std.chan.recv(prev)
            std.chan.send(nxt, v + 1)
        })
        cur = nxt
    }
    std.chan.send(first, 0)
    last := 0
    last = std.chan.recv(cur)
    println("relay:{last}")
    println("relay_ok")
}
