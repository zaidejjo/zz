import std.sqlz

struct User { id: int, name: str }

mydb := sqlz.open(":memory:")
mydb.exec("""CREATE TABLE users (id INTEGER, name TEXT)""")

// Parameterized insertion: {id}/{name} become ?1/?2 bound params.
id := 1
name := "alice"
mydb.exec("""INSERT INTO users VALUES ({id}, {name})""")
mydb.exec("""INSERT INTO users VALUES (2, 'bob')""")

// Injection resistance: hostile input binds as a value, matches 0 rows.
evil := "' OR '1'='1"
probe: [User] = mydb.query("""SELECT id, name FROM users WHERE name = {evil}""")
print(len(probe))

// Struct mapping: columns map positionally into [User].
users: [User] = mydb.query("""SELECT id, name FROM users WHERE name = {name}""")
print(users[0].name)
print(users[0].id)

// sqlz! macro desugars to query with identical parameterization.
q := "bob"
via_macro: [User] = sqlz!{mydb, """SELECT id, name FROM users WHERE name = {q}"""}
print(via_macro[0].name)

// std.db alias: identical functionality via the legacy namespace.
import std.db
alidb := db.open(":memory:")
alidb.exec("""CREATE TABLE t (v INTEGER)""")
alidb.exec("""INSERT INTO t VALUES (41)""")
print("alias_ok")

print("sqlz_ok")
