// E2E: std.json — JSON parsing and serialization
import std.json

// parse object
data := json.parse("{\"name\": \"Alice\", \"age\": 30}").unwrap()
println(json.as_str(json.get(data, "name").unwrap()))
println(json.as_int(json.get(data, "age").unwrap()))

// stringify
obj := {"key": "value", "num": 42}
match json.stringify(obj) {
  .ok(json_s) => println(json_s),
  .err(_) => println("FAIL")
}

// roundtrip
s := json.stringify(obj).unwrap()
parsed := json.parse(s).unwrap()
println(json.as_str(json.get(parsed, "key").unwrap()))

// json.get on arrays
arr := json.parse("[10, 20, 30]").unwrap()
println(json.as_int(json.get(arr, "0").unwrap()))
println(json.as_int(json.get(arr, "2").unwrap()))

println("json_ok")
