// E2E: std.json — JSON parsing and serialization
import std.json

// parse object
data := json.parse("{\"name\": \"Alice\", \"age\": 30}") ?? json.null()
println(json.as_str(json.get(data, "name") ?? json.null()))
println(json.as_int(json.get(data, "age") ?? json.null()))

// stringify
obj := {"key": "value", "num": 42}
s := json.stringify(obj) ?? "{}"
println(s)

// roundtrip
parsed := json.parse(s) ?? json.null()
println(json.as_str(json.get(parsed, "key") ?? json.null()))

// json.get on arrays
arr := json.parse("[10, 20, 30]") ?? json.null()
println(json.as_int(json.get(arr, "0") ?? json.null()))
println(json.as_int(json.get(arr, "2") ?? json.null()))

println("json_ok")
