// tests/fixtures/stdlib/net_tcp_test.zz — TCP operations on loopback.
// Bind ports derive from (pid, sweep task) so parallel runners
// (per-file parity tests, the discover sweep, e2e) never share them.
import std.env
import std.net
import std.fs
import std.str
import std.process(pid)

func main() -> Result<int, str> {
    // Per (process, sweep task) so parallel runners (per-file parity
    // tests, the discover sweep, e2e) never share ports. The sweep
    // token looks like "t{n}" ("0" outside the sweep), so strip the
    // prefix before parsing — bare int(token) never parses and
    // silently mixes 0.
    sweep_tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
    tok_num := int(str.replace(sweep_tok, "t", "")) ?? 0
    base_port := 20000 + pid() % 20000 + tok_num % 20000
    listen_addr := "127.0.0.1:{base_port}"
    refused_addr := "127.0.0.1:{base_port + 1}"
    // Test tcp_listen
    l := net.tcp_listen(listen_addr)?
    println("listen_ok")
    // Test tcp_connect to our listener
    c := net.tcp_connect(listen_addr, 5000)?
    ss := l.accept()?
    // Test peer_addr
    p := c.peer_addr()?
    println("peer_addr_ok: {p}")
    // Test local_addr
    a := c.local_addr()?
    println("local_addr_ok: {a}")
    // Test write/read roundtrip
    n := c.write("ping\n")?
    println("write_ok: {n}")
    d := ss.read(1024)?
    println("read_ok: {d}")
    // Test read_line
    c.write("line1\nline2\n")?
    println("write2_ok")
    line := ss.read_line()?
    println("readline_ok: {line}")
    line2 := ss.read_line()?
    println("readline2_ok: {line2}")
    // Test binary roundtrip (bytes survive intact, no UTF-8 decoding)
    blob := fs.read_bytes("tests/fixtures/stdlib/data/sample.tar")?
    c.write_bytes(blob[0:64])?
    b := ss.read_bytes(1024)?
    println("read_bytes_ok: {b.len()}:{b[0]}:{b[1]}")
    // Test set_read_timeout
    c.set_read_timeout(1000)?
    println("set_timeout_ok")
    // Close (real shutdown)
    c.close()?
    ss.close()?
    println("close_ok")

    // Test connection refused
    match net.tcp_connect(refused_addr, 1000) {
        .ok(_) => println("ERROR: should have failed")
        .err(_e) => println("connect_refused_ok")
    }

    // Test invalid address
    match net.tcp_connect("not-a-valid-addr", 1000) {
        .ok(_) => println("ERROR: should have failed")
        .err(_e) => println("bad_addr_ok")
    }

    println("net_tcp_test_ok")
    .ok(0)
}
