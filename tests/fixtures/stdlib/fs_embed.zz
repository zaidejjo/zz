// E2E (custom harness only): `zz run --embed <dir>` serves static assets
// through `fs.embedfs()`. NOT registered as a plain success fixture —
// without `--embed` the reads are (correctly) not_found.
import std.fs

func main() {
    match fs.embedfs() {
        .ok(e) => {
            match fs.read_to_string_at(e, "index.txt") {
                .ok(c) => println("index: {c}")
                .err(x) => println("index_err: {x}")
            }
            match fs.read_to_string_at(e, "css/site.css") {
                .ok(c) => println("css: {c}")
                .err(x) => println("css_err: {x}")
            }
            match fs.read_dir_at(e, "css") {
                .ok(entries) => println("css_dir: {entries}")
                .err(x) => println("dir_err: {x}")
            }
            println(fs.exists_at(e, "index.txt"))
            println(fs.is_dir_at(e, "css"))
            println(fs.is_file_at(e, "css"))
            match fs.write_at(e, "new.txt", "x") {
                .ok(_) => println("unexpected_write_ok")
                .err(x) => println("embed_readonly: {x}")
            }
        }
        .err(x) => println("embedfs_err: {x}")
    }
    println("fs_embed_ok")
}
