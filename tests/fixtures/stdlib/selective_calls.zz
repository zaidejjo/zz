// features: casts, import-alias, imports, locals, print, selective-import, std-path, std-str, string-literal
// E2E: selective imports of pure-ZZ functions resolve on every engine.
// Bare calls rewrite to their canonical paths (no synthetic binding).
import std.path(join, dirname)
import std.str(trim as t)

println(join("/a", "b"))
println(dirname("/a/b/c.txt"))
println(t("  padded  "))
j := join
println(j("/x", "y"))
println("selective_calls_ok")
