func main() -> Result<int, str> {
    for run in 0..5 {
        hits = 0
        h0 := task.spawn(|_| { inc1000() })
        h1 := task.spawn(|_| { inc1000() })
        h2 := task.spawn(|_| { inc1000() })
        h3 := task.spawn(|_| { inc1000() })
        task.join(h0)
        task.join(h1)
        task.join(h2)
        task.join(h3)
        if hits != 4000 {
            return .err("counter_mismatch")
        }
    }
    println("state_counter_ok")
    return .ok(0)
}
