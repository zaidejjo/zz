// features: imports, int-arith, locals, print, std-task, state
// TASK 1: semicolon-separated statements inside `atomic { }` under contention.
// 4 tasks x 1000 increments each = exactly 4000. Each iteration has two
// semicolon-separated `+=` increments (atomic RMW under the lock).
// Must pass with lock, fail without.
import std.task

state hits := 0

func inc1000() {
    for _ in 0..500 {
        atomic {
            hits += 1; hits += 1
        }
    }
}

func main() -> Result<int, str> {
    hits = 0
    h0 := task.spawn(|_| { inc1000() })
    h1 := task.spawn(|_| { inc1000() })
    h2 := task.spawn(|_| { inc1000() })
    h3 := task.spawn(|_| { inc1000() })
    task.join(h0)
    task.join(h1)
    task.join(h2)
    task.join(h3)
    x := hits
    // 4 tasks x 500 lines x 2 increments = 4000
    if x != 4000 {
        return .err("mismatch")
    }
    println("atomic_semicolon_ok")
    return .ok(0)
}
