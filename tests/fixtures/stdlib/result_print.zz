// E2E: Result/Option stdout presentation — `println(.ok(v))` prints `v`
// and `println(.some(v))` prints `v` directly (no wrappers) in both
// engines. Bare `.none` prints `none`. A bare printed `.err` throws a
// readable, hinted error instead (see below), so error cases stay in
// `match` arms here.
// Scratch path is per (process, sweep task) so parallel runners never
// share it.
import std.env
import std.fs
import std.process(pid)

func main() {
    tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
    scratch := "/tmp/zz_result_print_{pid()}_{tok}.txt"
    fs.write(scratch, "hello clean")
    // Bare Ok straight to stdout unwraps.
    println(fs.read_to_string(scratch))
    print(fs.read_to_string(scratch))
    println("")
    // Bare Some unwraps; bare None prints `none`.
    println(.some("unwrapped"))
    println(.some(42))
    println(.none)
    // Errors are handled explicitly and stay catchable.
    match fs.read_to_string("/tmp/zz_result_print_missing.txt") {
        .ok(c) => println("unexpected: {c}")
        .err(e) => println("caught: {e}")
    }
    fs.remove_file(scratch)
    println("result_print_ok")
}
