// E2E: Result stdout presentation — `println(.ok(v))` prints `v`
// directly (no `.ok(...)` wrapper) in both engines. A bare printed
// `.err` throws a readable, hinted error instead (see below), so error
// cases stay in `match` arms here.
import std.fs

func main() {
    fs.write("/tmp/zz_result_print.txt", "hello clean")
    // Bare Ok straight to stdout unwraps.
    println(fs.read_to_string("/tmp/zz_result_print.txt"))
    print(fs.read_to_string("/tmp/zz_result_print.txt"))
    println("")
    // Errors are handled explicitly and stay catchable.
    match fs.read_to_string("/tmp/zz_result_print_missing.txt") {
        .ok(c) => println("unexpected: {c}")
        .err(e) => println("caught: {e}")
    }
    fs.remove_file("/tmp/zz_result_print.txt")
    println("result_print_ok")
}
