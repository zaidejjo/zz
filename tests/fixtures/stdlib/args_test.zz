// E2E: std.args — flag parser over synthetic argv (no real CLI args,
// so the standard e2e harness works unchanged; real-argv flow is covered
// by args_raw_test.zz + a custom e2e test).
import std.args
import std.str

// NOTE: top-level bindings only (VM scope limitation); flag names used
// inside `{...}` live in bindings (no escapes in nested strings).
out_key := "output"
cnt_key := "count"
verb_key := "verbose"
out_def := "a.out"
usage := "Usage: myapp"
hprog := "myapp"

// ── space + equals forms, bool bare, subcommand ──
argv1 := ["--output", "b.out", "--count=3", "--verbose", "serve"]
p := ArgsParser.new()
p.str_flag(out_key, out_def)
p.int_flag(cnt_key, 1)
p.bool_flag(verb_key)
println("parse_ok: {p.parse(argv1)}")
println("out: {p.get_str(out_key)}")
println("count: {p.get_int(cnt_key)}")
println("verbose: {p.get_bool(verb_key)}")
println("sub: {p.subcommand()}")
match p.positional(0) {
    .some(s) => println("pos0: {s}"),
    .none => println("pos0_bad"),
}

// ── defaults when argv empty ──
// NOTE: conditions hoisted — nested if-in-if does not lower in AOT yet.
p4 := ArgsParser.new()
p4.str_flag(out_key, out_def)
p4.int_flag(cnt_key, 1)
p4.bool_flag(verb_key)
empty_argv := []
parsed4 := p4.parse(empty_argv)
vb := p4.get_bool(verb_key)
if parsed4 {
    println("def_out: {p4.get_str(out_key) == out_def}")
    println("def_count: {p4.get_int(cnt_key) == 1}")
}
if vb {
    println("def_verbose_bad")
} else {
    println("def_verbose_ok")
}

// ── unknown flag + error text ──
p2 := ArgsParser.new()
p2.str_flag(out_key, out_def)
bad_argv := ["--nope"]
if p2.parse(bad_argv) {
    println("err_bad")
} else {
    println("err_msg: {p2.error()}")
}

// ── bad int value ──
badint := ["--count", "x"]
p5 := ArgsParser.new()
p5.int_flag(cnt_key, 1)
if p5.parse(badint) {
    println("int_bad")
} else {
    println("int_err: {p5.error()}")
}

// ── help menu ──
h := p2.help(hprog)
println("help_usage: {str.contains(h, usage)}")
println("help_flag: {str.contains(h, out_key)}")

// ── --help short-circuits with empty error ──
p3 := ArgsParser.new()
helpargv := ["--help"]
if p3.parse(helpargv) {
    println("help_parse_bad")
} else {
    println("was_help: {p3.was_help()}")
}

println("args_ok")
