// features: imports, int-arith, locals, print, state, std-task
// S1 Parser matrix: `atomic := 1` then `atomic { }` under contention.
// `atomic` used as an identifier, then as a keyword block.
// 4 tasks x 1000 increments = 4000 total.
import std.task

state hits := 0

func inc(n: int) {
    for _ in 0..n {
        atomic {
            hits += 1
        }
    }
}

func main() -> Result<int, str> {
    hits = 0
    // `atomic` as an identifier (local var), then `atomic { }` as keyword block
    atomic := 0
    n := 1000
    h0 := task.spawn(|_| { inc(n) })
    h1 := task.spawn(|_| { inc(n) })
    h2 := task.spawn(|_| { inc(n) })
    h3 := task.spawn(|_| { inc(n) })
    task.join(h0)
    task.join(h1)
    task.join(h2)
    task.join(h3)
    x := hits
    // 4 tasks x 1000 = 4000
    if x != 4000 {
        return .err("mismatch: {x}")
    }
    println("atomic_matrix_var_then_block_ok")
    return .ok(0)
}
