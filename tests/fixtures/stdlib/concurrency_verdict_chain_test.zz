// E2E: verdict survival — a task released by handoff and re-suspended
// must not poison the sender's completion (suspend-verdict hygiene).
// T3 waits on chA then blocks on chB; T2's trailing send hands off to T3.
// T2's own completion must still arrive. Deterministic: sleeps order the
// registration before the send; the poll only observes.
import std.io
import std.task
import std.chan
import std.time

func main() {
    chA := std.chan()
    chB := std.chan()
    chZ := std.chan()
    std.chan.send(chZ, 5)
    h3 := task.spawn(|_| {
        x := 0
        x = std.chan.recv(chA)
        y := 0
        y = std.chan.recv(chB)
        x + y
    })
    time.sleep_ms(200)
    h2 := task.spawn(|_| {
        w := 0
        w = std.chan.recv(chZ)
        std.chan.send(chA, w)
    })
    done := 0
    for i in 0..200000 {
        q := task.try_join(h2)
        if let .some(v) = q {
            done = 1
            break
        }
    }
    io.println("h2_done:{done}")
    io.println("verdict_chain_ok")
}
