// features: closures, imports, locals, print, std-http, std-net, std-task, std-time, std-process, string-literal
// tests/fixtures/stdlib/http_listen_tls_test.zz — http.listen_tls C twin.
// Starts an HTTPS server on a loopback port (blocks until shutdown).
// Runs in a spawned task; main exits via process.exit(0) to kill the server.
// Mirrors the VM's rustls server (TLS 1.2/1.3, no client auth, ALPN http/1.1).
import std.env
import std.http
import std.process
import std.process(pid)
import std.task
import std.time

func main() -> () {
    sweep_tok := env.get("ZZ_SWEEP_TOKEN") ?? "0"
    tok_num := int(str.replace(sweep_tok, "t", "")) ?? 0
    tls_port := 34000 + (pid() * 2654435761 + tok_num * 40503) % 1990
    cert := "tests/fixtures/stdlib/data/net_tls/cert.pem"
    key := "tests/fixtures/stdlib/data/net_tls/key.pem"

    s := http.server()
    s = http.route_get(s, "/hello", |_req| "tls-hello")

    // Run the TLS listener in a spawned task (it blocks until shutdown).
    _ := task.spawn(|_| {
        http.listen_tls(s, tls_port, cert, key)
    })

    // Give the server time to start, then exit (killing the server task).
    time.sleep_ms(500)
    println("http_listen_tls_test_ok")
    std.process.exit(0)
}
