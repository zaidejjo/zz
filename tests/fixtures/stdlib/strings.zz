// E2E: std.str — string operations
import std.str

// length
println(str.length("hello"))

// split
parts := str.split("a,b,c", ",")
println(parts)
println(len(parts))

// contains
println(str.contains("hello world", "world"))
println(str.contains("hello", "xyz"))

// trim
println(str.trim("  hi  "))

// case conversion
println(str.to_upper("hello"))
println(str.to_lower("HELLO"))

// replace
println(str.replace("foo bar baz", "bar", "qux"))

// starts_with / ends_with
println(str.starts_with("hello", "he"))
println(str.ends_with("hello", "lo"))

// method syntax
println("hello".length())
println("hello world".split(" "))
println("hello".to_upper())
println("  hi  ".trim())

// multi-char separators (AOT parity: used to drop tail chars)
mc1 := str.split("abcXXdef", "XX")
println(mc1)
println(len(mc1))
mc2 := str.split("XXabc", "XX")
println(mc2)
mc3 := str.split("abcXX", "XX")
println(mc3)
println(len(mc3))
mc4 := str.split("aXXXXb", "XX")
println(mc4)
println(len(mc4))
mc5 := str.split("/a/b/c", "/a/b/")
println(mc5)

// string indexing (AOT parity: s[i] used to yield unit natively)
idxs := "abcdef"
println(idxs[0])
println(idxs[2])
println(idxs[-1])
println(idxs[0] == "a")
println(idxs[1] == "b")

println("str_ok")
