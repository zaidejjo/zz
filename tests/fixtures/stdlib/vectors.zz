// E2E: std.vec — array operations
import std.vec

nums := [3, 1, 4, 1, 5, 9]

// sort
println(vec.sort(nums))

// reverse
println(vec.reverse(nums))

// push
println(vec.push(nums, 2))

// pop
println(vec.pop(nums))

// contains
println(vec.contains(nums, 4))
println(vec.contains(nums, 99))

// join
println(vec.join(["a", "b", "c"], ", "))

// insert / remove
println(vec.insert([1, 2, 3], 1, 99))
println(vec.remove([1, 2, 3], 1))

// method syntax
println([3, 1, 2].sort())
println([1, 2, 3].reverse())
println(["x", "y"].join("-"))

println("vec_ok")
