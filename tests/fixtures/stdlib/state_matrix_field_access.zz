// S1 Parser matrix: `foo.state` (state as field name) under contention.
// 4 tasks x 1000 increments = 4000 total.
import std.task

struct Foo { state: int }

state hits := 0

func inc(n: int) {
    for _ in 0..n {
        atomic {
            hits = hits + 1
        }
    }
}

func main() -> Result<int, str> {
    hits = 0
    f := Foo { state: 7 }
    x := f.state
    _ = x
    n := 1000
    h0 := task.spawn(|_| { inc(n) })
    h1 := task.spawn(|_| { inc(n) })
    h2 := task.spawn(|_| { inc(n) })
    h3 := task.spawn(|_| { inc(n) })
    task.join(h0)
    task.join(h1)
    task.join(h2)
    task.join(h3)
    v := hits
    // 4 tasks x 1000 = 4000
    if v != 4000 {
        return .err("mismatch: {v}")
    }
    println("state_matrix_field_access_ok")
    return .ok(0)
}
