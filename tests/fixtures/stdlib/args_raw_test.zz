// E2E helper: prints the real process argv (used by a custom e2e test
// that passes CLI args; the standard harness passes none).
import std.args

raw := args.get_raw()
println("nargs: {len(raw)}")
if len(raw) > 0 {
    println("a0: {raw[0]}")
}
if len(raw) > 1 {
    println("a1: {raw[1]}")
}
if len(raw) > 2 {
    println("a2: {raw[2]}")
}
println("args_raw_ok")
